# NovaLeave — local development environment template
#
# Copy to .env and fill in. `.env` is gitignored and MUST NOT be committed.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# SQL Server SA password (local development only)
# ---------------------------------------------------------------------------
# Must satisfy SQL Server complexity rules: 8+ characters including uppercase,
# lowercase, digits, and symbols. Use a value unique to your machine.
MSSQL_SA_PASSWORD=ChangeMe_Local123!

# ---------------------------------------------------------------------------
# Host port for the dev database
# ---------------------------------------------------------------------------
# Defaults to 14333 rather than 1433 so it never collides with another local
# SQL instance you may already be running.
NOVALEAVE_SQL_PORT=14333

# ---------------------------------------------------------------------------
# Database image — pick the one matching your CPU architecture
# ---------------------------------------------------------------------------
# Apple Silicon (arm64):
NOVALEAVE_SQL_IMAGE=mcr.microsoft.com/azure-sql-edge:latest
# Intel / AMD (amd64) — full SQL Server, uncomment instead of the line above:
# NOVALEAVE_SQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
