@model NovaLeave.Web.ViewModels.MisSolicitudes.EditVacationRequestViewModel
@using NovaLeave.Application.Requests.Models
@{
    ViewData["Title"] = "Editar solicitud";
}


<form method="post" class="row g-3">
  <input asp-for="RowVersion" type="hidden" />
  <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
  <div class="col-md-4">
    <label asp-for="InputMode" class="form-label">Modo de ingreso</label>
    <select asp-for="InputMode" class="form-select">
      <option value="@RequestInputMode.DateRange">Rango de fechas</option>
      <option value="@RequestInputMode.StartPlusDays">Inicio y días hábiles</option>
    </select>
  </div>
  <div class="col-md-4">
    <label asp-for="StartDate" class="form-label">Fecha de inicio</label>
    <input asp-for="StartDate" type="date" class="form-control" />
  </div>
  <div class="col-md-4">
    <label asp-for="EndDate" class="form-label">Fecha de fin</label>
    <input asp-for="EndDate" type="date" class="form-control" />
  </div>
  <div class="col-md-4">
    <label asp-for="WorkingDays" class="form-label">Días hábiles</label>
    <input asp-for="WorkingDays" type="number" min="1" class="form-control" />
  </div>
  <div class="col-12">
    <label asp-for="Reason" class="form-label">Motivo</label>
    <textarea asp-for="Reason" class="form-control" rows="4" maxlength="500"></textarea>
  </div>
  <div class="col-12 d-flex gap-2">
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-outline-secondary" href="/mis-solicitudes/@Model.Id">Volver</a>
  </div>
</form>
