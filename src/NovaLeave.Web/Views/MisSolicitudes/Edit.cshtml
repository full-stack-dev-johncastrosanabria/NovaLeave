@model NovaLeave.Web.ViewModels.MisSolicitudes.EditVacationRequestViewModel
@using NovaLeave.Application.Requests.Models
@{
    ViewData["Title"] = "Editar solicitud";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">Mi espacio</p>
    <h1 class="nl-page-title">Editar solicitud pendiente</h1>
    <p class="nl-page-description">Solo las solicitudes pendientes pueden editarse.</p>
  </div>
</div>

<section class="nl-card nl-form-card">
  <div class="nl-card-body">
<form method="post" class="row g-3" data-submit-once>
  <input asp-for="RowVersion" type="hidden" />
  <partial name="_ValidationSummary" />
  <div class="col-md-4">
    <label asp-for="InputMode" class="form-label">Modo de ingreso</label>
    <select asp-for="InputMode" class="form-select">
      <option value="@RequestInputMode.DateRange">Fecha inicio + Fecha fin</option>
      <option value="@RequestInputMode.StartPlusDays">Fecha inicio + Cantidad de dias</option>
    </select>
  </div>
  <div class="col-md-4">
    <label asp-for="StartDate" class="form-label">Fecha de inicio</label>
    <input asp-for="StartDate" type="date" class="form-control" />
  </div>
  <div class="col-md-4">
    <label asp-for="EndDate" class="form-label">Fecha de fin</label>
    <input asp-for="EndDate" type="date" class="form-control" />
  </div>
  <div class="col-md-4">
    <label asp-for="WorkingDays" class="form-label">Dias habiles</label>
    <input asp-for="WorkingDays" type="number" min="1" class="form-control" />
  </div>
  <div class="col-12">
    <label asp-for="Reason" class="form-label">Motivo</label>
    <textarea asp-for="Reason" class="form-control" rows="4" maxlength="500" data-character-source></textarea>
    <span asp-validation-for="Reason" class="text-danger"></span>
    <div class="d-flex justify-content-between"><span class="form-text">Mantenga el motivo claro y concreto.</span><span class="form-text" data-character-count>0 / 500</span></div>
  </div>
  <div class="col-12 d-flex gap-2">
    <button type="submit" class="btn btn-primary" data-submit-button>Guardar cambios</button>
    <a class="btn btn-outline-secondary" href="/mis-solicitudes/@Model.Id">Volver</a>
  </div>
</form>
  </div>
</section>
