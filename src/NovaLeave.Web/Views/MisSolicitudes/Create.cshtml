@model NovaLeave.Web.ViewModels.MisSolicitudes.CreateVacationRequestViewModel
@using NovaLeave.Application.Requests.Models
@{
    ViewData["Title"] = "Crear solicitud";
}

<section class="row g-3 mb-3 nl-balance-overview" aria-label="Resumen de saldo" data-balance-summary data-available-days="@Model.AvailableDays">
  <div class="col-lg-4">
    <div class="nl-card nl-balance-primary h-100" data-projected-balance-card>
      <span class="nl-stat-label"><i class="bi bi-wallet2" aria-hidden="true"></i> Disponible</span>
      <strong class="nl-balance-primary-value nl-num">@Model.AvailableDays días</strong>
      <span class="nl-stat-hint">Es el saldo que realmente puede utilizarse para solicitar vacaciones.</span>
      <div class="nl-balance-projection">
        <span>Después de esta solicitud</span>
        <strong class="nl-num" data-projected-balance aria-live="polite">@Model.AvailableDays días</strong>
        <small data-projected-balance-hint>Estimado si la solicitud es aprobada</small>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="nl-card nl-balance-breakdown h-100">
      <div class="nl-balance-breakdown-header">
        <div>
          <span class="nl-eyebrow">Cómo se obtiene</span>
          <h2>Composición del saldo</h2>
        </div>
        <p><strong>Disponible</strong> = Acumulado total − Pendientes − Días gozados</p>
      </div>
      <div class="row g-0">
        <div class="col-sm-4 nl-balance-component">
          <span class="nl-stat-label"><i class="bi bi-calendar-check" aria-hidden="true"></i> Acumulado total</span>
          <strong class="nl-stat-value nl-num">@Model.AccruedDays días</strong>
          <span class="nl-stat-hint">Total histórico ganado; no equivale al disponible.</span>
        </div>
        <div class="col-sm-4 nl-balance-component">
          <span class="nl-stat-label"><i class="bi bi-hourglass-split" aria-hidden="true"></i> Pendientes</span>
          <strong class="nl-stat-value nl-num">@Model.ReservedDays días</strong>
          <span class="nl-stat-hint">Apartados por solicitudes pendientes.</span>
        </div>
        <div class="col-sm-4 nl-balance-component">
          <span class="nl-stat-label"><i class="bi bi-check2-circle" aria-hidden="true"></i> Días gozados</span>
          <strong class="nl-stat-value nl-num">@Model.DeductedDays días</strong>
          <span class="nl-stat-hint">Descontados por solicitudes aprobadas.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="row g-3">
  <div class="col-12">
    <form method="post" id="createRequestForm" novalidate data-create-request-form>
      <div class="nl-card">
        <div class="nl-card-header">
          <h2>Nueva solicitud de vacaciones</h2>
        </div>

        <div class="p-3 p-md-4">
          @* Business-rule failures other than insufficient balance remain inline. That specific
             condition uses the focused dialog below while preserving the entered values. *@
          @await Html.PartialAsync("_ValidationSummary")

          <div class="row g-3">
            <div class="col-md-6">
              <label asp-for="InputMode" class="form-label">Modo de ingreso</label>
              <select asp-for="InputMode" class="form-select" id="inputMode" aria-describedby="modeHelp">
                <option value="@RequestInputMode.DateRange">Fecha inicio + Fecha fin</option>
                <option value="@RequestInputMode.StartPlusDays">Fecha inicio + Cantidad de días</option>
              </select>
              <div id="modeHelp" class="form-text">Elige como quieres indicar el período.</div>
              <span asp-validation-for="InputMode" class="text-danger d-block nl-validation"></span>
            </div>

            <div class="col-md-6">
              <label asp-for="StartDate" class="form-label">
                Fecha de inicio <span class="nl-required" aria-hidden="true">*</span>
              </label>
              <input asp-for="StartDate" type="date" class="form-control" id="startDate" required aria-describedby="startHelp" />
              <div id="startHelp" class="form-text">Debe ser a partir del día siguiente.</div>
              <span asp-validation-for="StartDate" class="text-danger d-block nl-validation"></span>
            </div>

            <div class="col-md-6">
              <label asp-for="EndDate" class="form-label">Fecha de fin</label>
              <input asp-for="EndDate" type="date" class="form-control" id="endDate" aria-describedby="endHelp" data-derived-end-date />
              <div id="endHelp" class="form-text" data-mode-hint="startPlusDays" hidden>Se calcula a partir del inicio y los días hábiles.</div>
              <span asp-validation-for="EndDate" class="text-danger d-block nl-validation"></span>
            </div>

            <div class="col-md-6">
              <label asp-for="WorkingDays" class="form-label">Días hábiles</label>
              <input asp-for="WorkingDays" type="number" min="1" class="form-control nl-num" id="workingDays" aria-describedby="daysHelp" />
              <div id="daysHelp" class="form-text" data-mode-hint="dateRange">Calculado entre inicio y fin, sin sábados ni domingos.</div>
              <span asp-validation-for="WorkingDays" class="text-danger d-block nl-validation"></span>
            </div>

            <div class="col-12">
              <label asp-for="Reason" class="form-label">
                Motivo <span class="nl-required" aria-hidden="true">*</span>
              </label>
              <textarea asp-for="Reason" class="form-control" rows="4" minlength="10" maxlength="500" required aria-describedby="reasonHelp"></textarea>
              <div id="reasonHelp" class="form-text">
                Entre 10 y 500 caracteres. <span id="reasonCount" class="nl-num">0</span>/500
              </div>
              <span asp-validation-for="Reason" class="text-danger d-block nl-validation"></span>
            </div>
          </div>
        </div>

        <div class="d-flex flex-wrap gap-2 p-3 border-top">
          <button type="submit" class="btn btn-primary" id="submitButton">
            <span class="spinner-border spinner-border-sm me-1 d-none" id="submitSpinner" aria-hidden="true"></span>
            <span id="submitLabel">Crear solicitud</span>
          </button>
          <a class="btn btn-outline-secondary" href="/mis-solicitudes">Cancelar</a>
        </div>
      </div>
    </form>
  </div>

</div>

<dialog class="nl-balance-dialog"
        data-insufficient-balance-dialog
        data-show-on-load="@Model.ShowInsufficientBalanceDialog.ToString().ToLowerInvariant()"
        aria-labelledby="insufficientBalanceTitle"
        aria-describedby="insufficientBalanceDescription"
        aria-modal="true">
  <div class="nl-balance-dialog-header">
    <span class="nl-balance-dialog-icon" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
    <div>
      <span class="nl-eyebrow">Revisa tu solicitud</span>
      <h2 id="insufficientBalanceTitle">No tienes saldo suficiente</h2>
    </div>
  </div>

  <p id="insufficientBalanceDescription" class="nl-balance-dialog-description">
    El período seleccionado supera los días que puedes utilizar. Ajusta las fechas o la cantidad de días para continuar.
  </p>

  <dl class="nl-balance-dialog-summary" aria-label="Comparación de días">
    <div>
      <dt>Disponible</dt>
      <dd class="nl-num" data-dialog-available-days>@Model.AvailableDays días</dd>
    </div>
    <div>
      <dt>Días solicitados</dt>
      <dd class="nl-num" data-dialog-requested-days>0 días</dd>
    </div>
    <div class="nl-balance-dialog-missing">
      <dt>Días faltantes</dt>
      <dd class="nl-num" data-dialog-missing-days>0 días</dd>
    </div>
  </dl>

  <div class="nl-balance-dialog-actions">
    <button type="button" class="btn btn-primary" data-adjust-request>
      <i class="bi bi-calendar-range" aria-hidden="true"></i>
      Ajustar período
    </button>
    <button type="button" class="btn btn-outline-secondary" data-close-balance-dialog>Cerrar</button>
  </div>
</dialog>
