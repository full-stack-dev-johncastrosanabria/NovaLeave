@model NovaLeave.Web.ViewModels.MisSolicitudes.SolicitudDetalleViewModel
@using NovaLeave.Domain.Enums
@{
    ViewData["Title"] = "Detalle de solicitud";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">Mi espacio</p>
    <h1 class="nl-page-title">Detalle de solicitud</h1>
    <p class="nl-page-description">Información completa de su solicitud de vacaciones.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/mis-solicitudes">Volver</a>
</div>

<div class="nl-detail-grid mb-4">
<section class="nl-card">
  <div class="nl-card-body">
    <h2 class="h5 mb-3">Estado y fechas</h2>
    <dl class="nl-detail-list mb-0">
      <div><dt>Estado</dt><dd><partial name="_StatusBadge" model="Model.Request.Status.ToString()" /></dd></div>
      <div><dt>Fecha de inicio</dt><dd>@Model.Request.StartDate.ToString("dd/MM/yyyy")</dd></div>
      <div><dt>Fecha de fin</dt><dd>@Model.Request.EndDate.ToString("dd/MM/yyyy")</dd></div>
      <div><dt>Días hábiles</dt><dd><strong>@Model.Request.WorkingDays</strong></dd></div>
    </dl>
  </div>
</section>
<section class="nl-card">
  <div class="nl-card-body">
    <h2 class="h5 mb-3">Motivo</h2>
    <p class="nl-reason mb-0">@Model.Request.Reason</p>
  </div>
</section>
</div>

@if (Model.Request.Status == RequestStatus.Pending)
{
  <div class="nl-form-actions"><a class="btn btn-primary" href="/mis-solicitudes/@Model.Request.Id/editar">Editar solicitud</a><a class="btn btn-outline-secondary" href="/mis-solicitudes">Volver al historial</a></div>
}
