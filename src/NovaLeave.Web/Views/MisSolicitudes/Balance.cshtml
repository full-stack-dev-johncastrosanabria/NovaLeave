@model NovaLeave.Web.ViewModels.MisSolicitudes.SaldoViewModel
@{
    ViewData["Title"] = "Mi historial";
}

@functions {
    private static string MovementLabel(NovaLeave.Domain.Enums.MovementType type)
    {
        return type switch
        {
            NovaLeave.Domain.Enums.MovementType.Accrual => "Acumulación mensual",
            NovaLeave.Domain.Enums.MovementType.Reservation => "Reserva",
            NovaLeave.Domain.Enums.MovementType.Release => "Liberación",
            NovaLeave.Domain.Enums.MovementType.Deduction => "Deducción",
            NovaLeave.Domain.Enums.MovementType.Restoration => "Restauración",
            _ => type.ToString()
        };
    }

    private static (string Icon, string Css) MovementCue(NovaLeave.Domain.Enums.MovementType type)
    {
        return type switch
        {
            NovaLeave.Domain.Enums.MovementType.Accrual => ("bi-plus-circle", "text-success"),
            NovaLeave.Domain.Enums.MovementType.Reservation => ("bi-lock", "text-warning"),
            NovaLeave.Domain.Enums.MovementType.Release => ("bi-unlock", "text-secondary"),
            NovaLeave.Domain.Enums.MovementType.Deduction => ("bi-dash-circle", "text-danger"),
            NovaLeave.Domain.Enums.MovementType.Restoration => ("bi-arrow-counterclockwise", "text-info"),
            _ => ("bi-dot", "text-secondary")
        };
    }
}

<section class="nl-balance-dashboard" aria-label="Resumen de saldo">
  <div class="nl-card nl-balance-primary nl-balance-hero">
    <div class="nl-balance-hero-main">
      <span class="nl-eyebrow">Saldo para usar</span>
      <h2>Disponible</h2>
      <strong class="nl-balance-primary-value nl-num">@Model.Balance.AvailableDays días</strong>
      <p>Es el saldo que realmente puede utilizarse para nuevas solicitudes.</p>
      <a class="btn btn-primary align-self-start" href="/mis-solicitudes/crear">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> Crear solicitud
      </a>
    </div>
    <div class="nl-balance-hero-formula" aria-label="Cálculo del saldo disponible">
      <span class="nl-stat-label">Cálculo actual</span>
      <p class="nl-num">
        <strong>@Model.Balance.AccruedDays</strong>
        <span aria-hidden="true">−</span>
        <strong>@Model.Balance.ReservedDays</strong>
        <span aria-hidden="true">−</span>
        <strong>@Model.Balance.DeductedDays</strong>
        <span aria-hidden="true">=</span>
        <strong>@Model.Balance.AvailableDays</strong>
      </p>
      <small>Acumulado total − Pendientes − Días gozados</small>
    </div>
  </div>

  <div class="row g-3 nl-balance-metrics">
    <div class="col-md-4">
      <article class="nl-card nl-balance-metric h-100">
        <span class="nl-balance-metric-icon"><i class="bi bi-plus-circle" aria-hidden="true"></i></span>
        <div>
          <span class="nl-stat-label">Acumulado total</span>
          <strong class="nl-stat-value nl-num">@Model.Balance.AccruedDays días</strong>
          <p>Total histórico ganado desde el inicio laboral.</p>
        </div>
      </article>
    </div>
    <div class="col-md-4">
      <article class="nl-card nl-balance-metric h-100">
        <span class="nl-balance-metric-icon nl-balance-metric-icon-warning"><i class="bi bi-lock" aria-hidden="true"></i></span>
        <div>
          <span class="nl-stat-label">Pendientes</span>
          <strong class="nl-stat-value nl-num">@Model.Balance.ReservedDays días</strong>
          <p>Apartados temporalmente mientras se resuelven solicitudes.</p>
        </div>
      </article>
    </div>
    <div class="col-md-4">
      <article class="nl-card nl-balance-metric h-100">
        <span class="nl-balance-metric-icon nl-balance-metric-icon-neutral"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
        <div>
          <span class="nl-stat-label">Días gozados</span>
          <strong class="nl-stat-value nl-num">@Model.Balance.DeductedDays días</strong>
          <p>Descontados por solicitudes que ya fueron aprobadas.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<div class="nl-card">
  <div class="nl-card-header">
    <h2>Historial de movimientos</h2>
    <span class="text-body-secondary" style="font-size:12px">@Model.Balance.Movements.Count() movimiento@(Model.Balance.Movements.Count() == 1 ? "" : "s")</span>
  </div>

  @if (!Model.Balance.Movements.Any())
  {
    <div class="nl-empty">
      <i class="bi bi-clock-history" aria-hidden="true"></i>
      <p class="mb-0">Todavia no hay movimientos de saldo.</p>
    </div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table nl-table align-middle">
        <caption class="visually-hidden">Movimientos de saldo propios</caption>
        <thead>
          <tr>
            <th scope="col">Fecha</th>
            <th scope="col">Tipo</th>
            <th scope="col" class="text-end">Días</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var movement in Model.Balance.Movements)
          {
            var cue = MovementCue(movement.Type);
            <tr data-movement-type="@movement.Type">
              <td>@movement.EffectiveAt</td>
              <td>
                <span class="nl-status">
                  <i class="bi @cue.Icon @cue.Css" aria-hidden="true"></i>
                  <span>@MovementLabel(movement.Type)</span>
                </span>
              </td>
              <td class="text-end">@movement.Amount</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
