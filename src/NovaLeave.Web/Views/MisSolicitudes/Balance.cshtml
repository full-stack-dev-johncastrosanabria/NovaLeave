@model NovaLeave.Web.ViewModels.MisSolicitudes.SaldoViewModel
@{
    ViewData["Title"] = "Mi saldo";
}

@functions {
    private static string MovementLabel(NovaLeave.Domain.Enums.MovementType type)
    {
        return type switch
        {
            NovaLeave.Domain.Enums.MovementType.Accrual => "Acumulacion mensual",
            NovaLeave.Domain.Enums.MovementType.Reservation => "Reserva",
            NovaLeave.Domain.Enums.MovementType.Release => "Liberacion",
            NovaLeave.Domain.Enums.MovementType.Deduction => "Deduccion",
            NovaLeave.Domain.Enums.MovementType.Restoration => "Restauracion",
            _ => type.ToString()
        };
    }
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">Mi espacio</p>
    <h1 class="nl-page-title">Mi saldo</h1>
    <p class="nl-page-description">Resumen e historial de movimientos de vacaciones.</p>
  </div>
</div>

<div class="nl-summary-grid mb-4">
  <section class="nl-card nl-summary-card" aria-label="Acumulado total"><div class="nl-summary-label">Acumulado total</div><div class="nl-summary-value">@Model.Balance.AccruedDays</div></section>
  <section class="nl-card nl-summary-card" aria-label="Pendientes"><div class="nl-summary-label">Pendientes</div><div class="nl-summary-value">@Model.Balance.ReservedDays</div></section>
  <section class="nl-card nl-summary-card" aria-label="Días gozados"><div class="nl-summary-label">Días gozados</div><div class="nl-summary-value">@Model.Balance.DeductedDays</div></section>
  <section class="nl-card nl-summary-card" aria-label="Disponible"><div class="nl-summary-label">Disponible</div><div class="nl-summary-value">@Model.Balance.AvailableDays</div></section>
</div>

<section class="nl-card" aria-labelledby="movements-title">
  <div class="nl-card-body">
<h2 id="movements-title" class="h5 mb-3">Historial de movimientos</h2>
<div class="table-responsive">
  <table class="table nl-table nl-table-card align-middle">
    <caption>Movimientos de saldo propios</caption>
    <thead>
      <tr>
        <th scope="col">Fecha</th>
        <th scope="col">Tipo</th>
        <th scope="col">Dias</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var movement in Model.Balance.Movements)
      {
        <tr data-movement-type="@movement.Type">
          <td>@movement.EffectiveAt</td>
          <td>@MovementLabel(movement.Type)</td>
          <td>@movement.Amount</td>
        </tr>
      }
    </tbody>
  </table>
</div>
  </div>
</section>
