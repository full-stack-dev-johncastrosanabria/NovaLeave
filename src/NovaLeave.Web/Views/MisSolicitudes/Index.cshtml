@model NovaLeave.Web.ViewModels.MisSolicitudes.MisSolicitudesIndexViewModel
@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">Mis solicitudes</h1>
    <p class="text-body-secondary mb-0">Solicitudes propias de vacaciones.</p>
  </div>
  <a class="btn btn-primary" href="/mis-solicitudes/crear">Nueva solicitud</a>
</div>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <caption>Listado de solicitudes propias</caption>
    <thead>
      <tr>
        <th scope="col">Inicio</th>
        <th scope="col">Fin</th>
        <th scope="col">Dias habiles</th>
        <th scope="col">Estado</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var request in Model.Requests)
      {
        <tr>
          <td>@request.StartDate.ToString("yyyy-MM-dd")</td>
          <td>@request.EndDate.ToString("yyyy-MM-dd")</td>
          <td>@request.WorkingDays</td>
          <td>@request.Status</td>
          <td>
            <a class="btn btn-sm btn-outline-primary" href="/mis-solicitudes/@request.Id">Ver</a>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
