@model NovaLeave.Web.ViewModels.MisSolicitudes.MisSolicitudesIndexViewModel
@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">Mi espacio</p>
    <h1 class="nl-page-title">Mis solicitudes</h1>
    <p class="nl-page-description">Solicitudes propias de vacaciones.</p>
  </div>
  <a class="btn btn-primary" href="/mis-solicitudes/crear">Nueva solicitud</a>
</div>

<section class="nl-card" aria-labelledby="requests-title">
  <div class="nl-card-body">
    <h2 id="requests-title" class="h5 mb-3">Mi historial</h2>
    @if (!Model.Requests.Any())
    {
      <div class="nl-empty" role="status"><partial name="_EmptyStateIcon" /><strong>Aún no tienes solicitudes.</strong><span>Cuando registres vacaciones, podrás consultar aquí su estado y detalle.</span><a class="btn btn-primary" href="/mis-solicitudes/crear">Crear primera solicitud</a></div>
    }
    else
    {
  <div class="table-responsive">
  <table class="table nl-table nl-responsive-table align-middle">
    <caption>Listado de solicitudes propias</caption>
    <thead>
      <tr>
        <th scope="col">Inicio</th>
        <th scope="col">Fin</th>
        <th scope="col">Dias habiles</th>
        <th scope="col">Estado</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var request in Model.Requests)
      {
        <tr>
          <td data-label="Inicio">@request.StartDate.ToString("dd/MM/yyyy")</td>
          <td data-label="Fin">@request.EndDate.ToString("dd/MM/yyyy")</td>
          <td data-label="Días hábiles">@request.WorkingDays</td>
          <td data-label="Estado"><partial name="_StatusBadge" model="request.Status.ToString()" /></td>
          <td data-label="Acción">
            <a class="btn btn-sm btn-outline-primary" href="/mis-solicitudes/@request.Id">Ver detalle</a>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>
    }
  </div>
</section>
