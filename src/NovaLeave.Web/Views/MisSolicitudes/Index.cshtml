@model NovaLeave.Web.ViewModels.MisSolicitudes.MisSolicitudesIndexViewModel
@{
    ViewData["Title"] = "Mis solicitudes";
    var requests = Model.Requests.ToList();
    var pending = requests.Count(request => request.Status == NovaLeave.Domain.Enums.RequestStatus.Pending);
    var approved = requests.Count(request => request.Status == NovaLeave.Domain.Enums.RequestStatus.Approved);
}

<section class="nl-page-intro" aria-labelledby="my-requests-title">
  <div>
    <span class="nl-eyebrow">Mi espacio</span>
    <h1 id="my-requests-title">Mis solicitudes</h1>
    <p>Consulta el estado de tus vacaciones y abre el detalle de cada solicitud.</p>
  </div>
  <a class="btn btn-primary" href="/mis-solicitudes/crear">
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
    Nueva solicitud
  </a>
</section>

<section class="nl-request-summary" aria-label="Resumen de mis solicitudes">
  <div class="nl-card nl-request-summary-item nl-request-summary-primary">
    <span class="nl-request-summary-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span>
    <div><span>Total de solicitudes</span><strong class="nl-num">@requests.Count</strong></div>
  </div>
  <div class="nl-card nl-request-summary-item">
    <span class="nl-request-summary-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
    <div><span>En revisión</span><strong class="nl-num">@pending</strong></div>
  </div>
  <div class="nl-card nl-request-summary-item">
    <span class="nl-request-summary-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
    <div><span>Aprobadas</span><strong class="nl-num">@approved</strong></div>
  </div>
</section>

<section class="nl-card nl-request-list-card" aria-labelledby="my-request-list-title">
  <div class="nl-card-header nl-request-list-header">
    <div>
      <h2 id="my-request-list-title">Historial de solicitudes</h2>
      <p>Vacaciones solicitadas y su estado actual.</p>
    </div>
    <span class="nl-result-count">@requests.Count registro@(requests.Count == 1 ? "" : "s")</span>
  </div>

  @if (requests.Count == 0)
  {
    <div class="nl-empty">
      <i class="bi bi-journal-plus" aria-hidden="true"></i>
      <p class="mb-1 fw-medium text-body">Todavía no tienes solicitudes</p>
      <p class="mb-3">Crea tu primera solicitud de vacaciones para darle seguimiento aquí.</p>
      <a class="btn btn-primary btn-sm" href="/mis-solicitudes/crear">Crear solicitud</a>
    </div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table nl-table nl-request-table align-middle">
        <caption class="visually-hidden">Listado de solicitudes propias</caption>
        <thead>
          <tr>
            <th scope="col">Período solicitado</th>
            <th scope="col" class="text-end">Días hábiles</th>
            <th scope="col">Estado</th>
            <th scope="col" class="text-end"><span class="visually-hidden">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var request in requests)
          {
            <tr>
              <td data-label="Período solicitado">
                <span class="nl-request-period">
                  <span>@request.StartDate.ToString("dd/MM/yyyy")</span>
                  <i class="bi bi-arrow-right" aria-hidden="true"></i>
                  <span>@request.EndDate.ToString("dd/MM/yyyy")</span>
                </span>
              </td>
              <td data-label="Días hábiles" class="text-end nl-num">@request.WorkingDays</td>
              <td data-label="Estado">@await Html.PartialAsync("_StatusBadge", request.Status.ToString())</td>
              <td data-label="Acción" class="text-end nl-request-table-action">
                <a class="btn btn-sm btn-outline-primary" href="/mis-solicitudes/@request.Id"
                   aria-label="Ver detalle de la solicitud del @request.StartDate.ToString("dd/MM/yyyy")">
                  Ver detalle
                </a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</section>
