@model NovaLeave.Web.ViewModels.MisSolicitudes.MisSolicitudesIndexViewModel
@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
  <p class="text-body-secondary mb-0">Solicitudes propias de vacaciones.</p>
  <a class="btn btn-primary" href="/mis-solicitudes/crear">
    <i class="bi bi-plus-lg" aria-hidden="true"></i>
    <span class="ms-1">Nueva solicitud</span>
  </a>
</div>

<div class="nl-card">
  @if (!Model.Requests.Any())
  {
    <div class="text-center text-body-secondary py-5 px-3">
      <i class="bi bi-journal-text d-block mb-2" style="font-size:2rem" aria-hidden="true"></i>
      <p class="mb-3">Todavia no tienes solicitudes de vacaciones.</p>
      <a class="btn btn-primary" href="/mis-solicitudes/crear">Crear la primera</a>
    </div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <caption class="px-3">Listado de solicitudes propias</caption>
        <thead>
          <tr>
            <th scope="col">Inicio</th>
            <th scope="col">Fin</th>
            <th scope="col" class="text-end">Dias habiles</th>
            <th scope="col">Estado</th>
            <th scope="col"><span class="visually-hidden">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var request in Model.Requests)
          {
            <tr>
              <td>@request.StartDate.ToString("yyyy-MM-dd")</td>
              <td>@request.EndDate.ToString("yyyy-MM-dd")</td>
              <td class="text-end">@request.WorkingDays</td>
              <td>@await Html.PartialAsync("_StatusBadge", request.Status.ToString())</td>
              <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" href="/mis-solicitudes/@request.Id"
                   aria-label="Ver detalle de la solicitud del @request.StartDate.ToString("yyyy-MM-dd")">
                  Ver
                </a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
