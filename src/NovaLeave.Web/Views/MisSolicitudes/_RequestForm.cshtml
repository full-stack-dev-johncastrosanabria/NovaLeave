@model NovaLeave.Web.ViewModels.MisSolicitudes.VacationRequestFormViewModel
@using NovaLeave.Application.Requests.Models

<partial name="_ValidationSummary" />

<fieldset class="mb-4">
  <legend class="form-label fw-semibold">Modo de ingreso</legend>
  <div class="nl-segmented" role="radiogroup" aria-label="Modo de ingreso de vacaciones">
    <input asp-for="InputMode" type="radio" value="@RequestInputMode.DateRange" id="modeDateRange" />
    <label for="modeDateRange">Fecha inicio + Fecha fin</label>
    <input asp-for="InputMode" type="radio" value="@RequestInputMode.StartPlusDays" id="modeStartPlusDays" />
    <label for="modeStartPlusDays">Fecha inicio + Cantidad de días</label>
  </div>
  <span asp-validation-for="InputMode" class="text-danger"></span>
</fieldset>

<div class="row g-4" data-request-form data-available-days="@Model.AvailableDays">
  <div class="col-md-6">
    <label asp-for="StartDate" class="form-label">Fecha de inicio</label>
    <input asp-for="StartDate" type="date" class="form-control" data-request-start />
    <span asp-validation-for="StartDate" class="text-danger"></span>
    <div class="form-text">La fecha debe ser posterior a hoy.</div>
  </div>

  <div class="col-md-6" data-date-range-field>
    <label asp-for="EndDate" class="form-label">Fecha de fin</label>
    <input asp-for="EndDate" type="date" class="form-control" data-request-end />
    <span asp-validation-for="EndDate" class="text-danger"></span>
  </div>

  <div class="col-md-6" data-working-days-field>
    <label asp-for="WorkingDays" class="form-label">Cantidad de días hábiles</label>
    <input asp-for="WorkingDays" type="number" min="1" step="1" class="form-control" data-request-days />
    <span asp-validation-for="WorkingDays" class="text-danger"></span>
  </div>

  <div class="col-12">
    <div class="nl-calculation-panel" aria-live="polite">
      <div><span>Días hábiles calculados</span><strong data-calculated-days>—</strong></div>
      <div><span>Fecha final calculada</span><strong data-calculated-end>—</strong></div>
      @if (Model.AvailableDays is not null)
      {
        <div><span>Disponible actual</span><strong>@Model.AvailableDays días</strong></div>
        <div><span>Disponible después de reservar</span><strong data-calculated-projection>—</strong></div>
      }
    </div>
    <p class="form-text mb-0">Los cálculos mostrados son informativos. El servidor validará fechas, días y saldo al guardar.</p>
  </div>

  <div class="col-12">
    <div class="d-flex justify-content-between align-items-end gap-3">
      <label asp-for="Reason" class="form-label">Motivo</label>
      <span class="form-text" data-character-count>0 / 500</span>
    </div>
    <textarea asp-for="Reason" class="form-control" rows="4" minlength="10" maxlength="500" data-character-source></textarea>
    <span asp-validation-for="Reason" class="text-danger"></span>
    <div class="form-text">Escriba entre 10 y 500 caracteres. No incluya información sensible innecesaria.</div>
  </div>
</div>
