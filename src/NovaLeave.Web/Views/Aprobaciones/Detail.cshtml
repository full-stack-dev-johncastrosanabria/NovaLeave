@model NovaLeave.Web.ViewModels.Aprobaciones.AprobacionDetalleViewModel
@{
    ViewData["Title"] = "Detalle para resolucion";
}

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
  <h1 class="h3 mb-0">Detalle para resolucion</h1>
  <a class="btn btn-outline-secondary" href="/aprobaciones">Volver</a>
</div>

<dl class="row">
  <dt class="col-sm-3">Solicitante</dt>
  <dd class="col-sm-9">@Model.Request.RequesterId</dd>
  <dt class="col-sm-3">Inicio</dt>
  <dd class="col-sm-9">@Model.Request.StartDate.ToString("yyyy-MM-dd")</dd>
  <dt class="col-sm-3">Fin</dt>
  <dd class="col-sm-9">@Model.Request.EndDate.ToString("yyyy-MM-dd")</dd>
  <dt class="col-sm-3">Dias habiles</dt>
  <dd class="col-sm-9">@Model.Request.WorkingDays</dd>
  <dt class="col-sm-3">Saldo proyectado</dt>
  <dd class="col-sm-9">@Model.Request.ProjectedBalanceAfterApproval</dd>
  <dt class="col-sm-3">RowVersion</dt>
  <dd class="col-sm-9"><code>@Model.RowVersion</code></dd>
</dl>

@if (Model.Request.HasOverlapWarning)
{
  <div class="alert alert-warning" role="alert">Existe una advertencia de traslape.</div>
}

<div class="row g-3">
  <div class="col-md-4">
    <form method="post" action="/aprobaciones/@Model.Request.Id/aprobar">
      <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
      <button type="submit" class="btn btn-success w-100">Aprobar</button>
    </form>
  </div>
  <div class="col-md-8">
    <form method="post" action="/aprobaciones/@Model.Request.Id/rechazar">
      <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
      <label class="form-label" for="RejectionReason">Razon de rechazo</label>
      <textarea id="RejectionReason" name="RejectionReason" class="form-control mb-2" rows="3" maxlength="500"></textarea>
      <button type="submit" class="btn btn-danger">Rechazar</button>
    </form>
  </div>
</div>
