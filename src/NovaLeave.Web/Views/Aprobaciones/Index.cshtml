@model NovaLeave.Web.ViewModels.Aprobaciones.AprobacionesIndexViewModel
@{
    ViewData["Title"] = "Solicitudes pendientes";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">Aprobaciones</p>
    <h1 class="nl-page-title">Solicitudes pendientes</h1>
    <p class="nl-page-description">Revise solicitudes elegibles y su impacto de saldo antes de resolver.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/aprobaciones/historial">Historial</a>
</div>

<section class="nl-card" aria-labelledby="approvals-title">
  <div class="nl-card-body">
    <div class="nl-section-heading"><div><h2 id="approvals-title" class="h5 mb-1">Pendientes</h2><p class="text-body-secondary mb-0">@Model.Requests.Count solicitudes requieren revisión</p></div></div>
    @if (!Model.Requests.Any())
    {
      <div class="nl-empty" role="status">No hay solicitudes pendientes de resolucion.</div>
    }
    else
    {
<div class="table-responsive">
  <table class="table nl-table nl-responsive-table align-middle">
    <caption>Solicitudes pendientes de resolucion</caption>
    <thead>
      <tr>
        <th scope="col">Solicitante</th>
        <th scope="col">Inicio</th>
        <th scope="col">Fin</th>
        <th scope="col">Dias</th>
        <th scope="col">Disponible actual</th>
        <th scope="col">Días solicitados</th>
        <th scope="col">Disponible después de aprobar</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var request in Model.Requests)
      {
        <tr>
          <td data-label="Solicitante"><strong>@request.RequesterName</strong></td>
          <td data-label="Inicio">@request.StartDate.ToString("dd/MM/yyyy")</td>
          <td data-label="Fin">@request.EndDate.ToString("dd/MM/yyyy")</td>
          <td data-label="Días">@request.WorkingDays</td>
          <td data-label="Disponible actual">@request.AvailableDays</td>
          <td data-label="Días solicitados">@request.WorkingDays</td>
          <td data-label="Disponible después de aprobar" data-projected-balance="@request.ProjectedBalanceAfterApproval"><strong class="@(request.ProjectedBalanceAfterApproval < 0 ? "text-danger" : string.Empty)">@request.ProjectedBalanceAfterApproval</strong></td>
          <td data-label="Acciones"><a class="btn btn-sm btn-outline-primary" href="/aprobaciones/@request.Id">Revisar solicitud</a></td>
        </tr>
      }
    </tbody>
  </table>
</div>
    }
  </div>
</section>
