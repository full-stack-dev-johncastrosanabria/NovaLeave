@model NovaLeave.Web.ViewModels.Aprobaciones.AprobacionesIndexViewModel
@{
    ViewData["Title"] = "Solicitudes pendientes";
}

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
  <h1 class="h3 mb-0">Solicitudes pendientes</h1>
  <a class="btn btn-outline-secondary" href="/aprobaciones/historial">Historial</a>
</div>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <caption>Solicitudes pendientes de resolucion</caption>
    <thead>
      <tr>
        <th scope="col">Solicitante</th>
        <th scope="col">Inicio</th>
        <th scope="col">Fin</th>
        <th scope="col">Dias</th>
        <th scope="col">Disponible</th>
        <th scope="col">Saldo proyectado</th>
        <th scope="col">Acciones</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var request in Model.Requests)
      {
        <tr>
          <td>@request.RequesterId</td>
          <td>@request.StartDate.ToString("yyyy-MM-dd")</td>
          <td>@request.EndDate.ToString("yyyy-MM-dd")</td>
          <td>@request.WorkingDays</td>
          <td>@request.AvailableDays</td>
          <td>@request.ProjectedBalanceAfterApproval</td>
          <td><a class="btn btn-sm btn-outline-primary" href="/aprobaciones/@request.Id">Resolver</a></td>
        </tr>
      }
    </tbody>
  </table>
</div>
