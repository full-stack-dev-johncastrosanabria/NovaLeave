@model NovaLeave.Web.ViewModels.Aprobaciones.AprobacionesIndexViewModel
@{
    ViewData["Title"] = "Solicitudes pendientes";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
  <p class="text-body-secondary mb-0">
    Solicitudes de otras personas que esperan resolución.
  </p>
  <a class="btn btn-outline-secondary" href="/aprobaciones/historial">
    <i class="bi bi-clock-history" aria-hidden="true"></i>
    <span class="ms-1">Historial</span>
  </a>
</div>

<div class="nl-card">
  @if (!Model.Requests.Any())
  {
    <div class="nl-empty">
      <i class="bi bi-inbox" aria-hidden="true"></i>
      <p class="mb-1 fw-medium text-body">Bandeja vacia</p>
      <p class="mb-0">No hay solicitudes pendientes de resolución.</p>
    </div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table nl-table align-middle">
        <caption class="visually-hidden">Solicitudes pendientes de resolución</caption>
        <thead>
          <tr>
            <th scope="col">Solicitante</th>
            <th scope="col">Inicio</th>
            <th scope="col">Fin</th>
            <th scope="col" class="text-end">Días</th>
            <th scope="col" class="text-end">Disponible</th>
            <th scope="col" class="text-end">Saldo proyectado</th>
            <th scope="col"><span class="visually-hidden">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var request in Model.Requests)
          {
            @* A negative projection means approving would overdraw the balance; flag it with an
               icon and text so the cue does not depend on colour. *@
            var overdrawn = request.ProjectedBalanceAfterApproval < 0;
            <tr>
              <td class="text-truncate" style="max-width:14rem">@request.RequesterId</td>
              <td>@request.StartDate.ToString("yyyy-MM-dd")</td>
              <td>@request.EndDate.ToString("yyyy-MM-dd")</td>
              <td class="text-end">@request.WorkingDays</td>
              <td class="text-end">@request.AvailableDays</td>
              <td class="text-end @(overdrawn ? "text-danger fw-semibold" : null)">
                @if (overdrawn)
                {
                  <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                  <span class="visually-hidden">Saldo insuficiente:</span>
                }
                @request.ProjectedBalanceAfterApproval
              </td>
              <td class="text-end">
                <a class="btn btn-sm btn-primary" href="/aprobaciones/@request.Id"
                   aria-label="Resolver la solicitud de @request.RequesterId">
                  Resolver
                </a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
