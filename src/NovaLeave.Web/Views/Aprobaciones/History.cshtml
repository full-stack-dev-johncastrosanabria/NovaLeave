@model NovaLeave.Web.ViewModels.Aprobaciones.AprobacionesHistorialViewModel
@{
    ViewData["Title"] = "Historial de resoluciones";
}


<div class="table-responsive">
  <table class="table nl-table align-middle">
    <caption class="visually-hidden">Historial de acciones del aprobador</caption>
    <thead>
      <tr>
        <th scope="col">Fecha y hora (Costa Rica)</th>
        <th scope="col">Acción</th>
        <th scope="col">Solicitud</th>
        <th scope="col">Solicitante</th>
        <th scope="col">Estado</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var item in Model.Items)
      {
        <tr>
          <td>@CostaRicaTime.ToLocalDateTime(item.TimestampUtc).ToString("dd/MM/yyyy HH:mm")</td>
          <td>@item.Action</td>
          <td><a href="/aprobaciones/@item.RequestId">@item.RequestId</a></td>
          <td>@item.RequesterId</td>
          <td>@item.Status</td>
        </tr>
      }
    </tbody>
  </table>
</div>
