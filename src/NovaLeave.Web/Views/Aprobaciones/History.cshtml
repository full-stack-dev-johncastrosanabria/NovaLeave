@model NovaLeave.Web.ViewModels.Aprobaciones.AprobacionesHistorialViewModel
@{
    ViewData["Title"] = "Historial de resoluciones";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">Aprobaciones</p>
    <h1 class="nl-page-title">Historial de resoluciones</h1>
    <p class="nl-page-description">Acciones registradas para el aprobador actual.</p>
  </div>
</div>

<section class="nl-card">
  <div class="nl-card-body">
@if (!Model.Items.Any())
{
  <div class="nl-empty" role="status"><partial name="_EmptyStateIcon" /><strong>No hay resoluciones realizadas.</strong><span>El historial se actualizará después de resolver solicitudes.</span><a class="btn btn-outline-primary" href="/aprobaciones">Ver solicitudes pendientes</a></div>
}
else
{
<div class="table-responsive">
  <table class="table nl-table nl-responsive-table align-middle">
    <caption>Historial de acciones del aprobador</caption>
    <thead>
      <tr>
        <th scope="col">Fecha</th>
        <th scope="col">Accion</th>
        <th scope="col">Solicitud</th>
        <th scope="col">Solicitante</th>
        <th scope="col">Estado</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var item in Model.Items)
      {
        <tr>
          <td data-label="Fecha">@item.TimestampUtc.ToString("dd/MM/yyyy HH:mm")</td>
          <td data-label="Acción">@(item.Action == "Approve" ? "Aprobación" : item.Action == "Reject" ? "Rechazo" : item.Action == "Deactivate" ? "Desactivación" : item.Action)</td>
          <td data-label="Detalle"><a class="btn btn-sm btn-outline-primary" href="/aprobaciones/@item.RequestId">Ver detalle</a></td>
          <td data-label="Solicitante">Usuario solicitante</td>
          <td data-label="Estado"><partial name="_StatusBadge" model="item.Status.ToString()" /></td>
        </tr>
      }
    </tbody>
  </table>
</div>
}
  </div>
</section>
