@model NovaLeave.Application.Calendars.CalendarViewModel

@functions {
    private static IReadOnlyList<IReadOnlyList<NovaLeave.Application.Calendars.CalendarDay>> Weeks(IReadOnlyList<NovaLeave.Application.Calendars.CalendarDay> days)
    {
        return days
            .Select((day, index) => new { day, index })
            .GroupBy(item => item.index / 7)
            .Select(group => group.Select(item => item.day).ToList())
            .ToList();
    }
}

<section aria-label="@Model.Title">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h5 mb-0">
      <i class="bi bi-calendar3 text-body-secondary me-1" aria-hidden="true"></i>
      @Model.CurrentMonth.DisplayName
    </h2>
    <span class="badge text-bg-light border">@(Model.CurrentRole == NovaLeave.Application.Calendars.RoleContext.HR ? "RRHH" : Model.CurrentRole.ToString())</span>
  </div>

  <div class="nl-card p-2 mb-3 table-responsive">
  <table class="table table-bordered align-middle calendar-grid nl-calendar mb-0" role="grid" aria-label="@Model.Title" data-calendar-keyboard="true">
    <caption class="visually-hidden">@Model.Title</caption>
    <thead>
      <tr>
        <th scope="col"><abbr title="Lunes">Lun</abbr></th>
        <th scope="col"><abbr title="Martes">Mar</abbr></th>
        <th scope="col"><abbr title="Miércoles">Mié</abbr></th>
        <th scope="col"><abbr title="Jueves">Jue</abbr></th>
        <th scope="col"><abbr title="Viernes">Vie</abbr></th>
        <th scope="col"><abbr title="Sábado">Sáb</abbr></th>
        <th scope="col"><abbr title="Domingo">Dom</abbr></th>
      </tr>
    </thead>
    <tbody>
      @foreach (var week in Weeks(Model.Days))
      {
        <tr role="row">
          @foreach (var day in week)
          {
            var dayClass = day.IsWeekend ? "nl-weekend text-body-secondary" : day.IsCurrentMonth ? string.Empty : "nl-outside text-body-secondary";
            <td class="@dayClass @(day.IsToday ? "nl-today" : null)" role="gridcell" aria-label="@day.Date.ToString("yyyy-MM-dd")" tabindex="@(day.IsWeekend ? "-1" : "0")">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <span class="nl-day-number">@day.Date.Day</span>
                @if (day.IsWeekend)
                {
                  <span class="visually-hidden">Fin de semana</span>
                }
              </div>
              <div class="mt-1">
                @foreach (var item in day.Events.Take(2))
                {
                  var detailUrl = item.DetailUrl(Model.DetailRouteTemplate);
                  @* The label and day count stay in the accessible name so the compact chip
                     remains fully described to assistive technology. *@
                  if (detailUrl is not null)
                  {
                    <a class="nl-event text-bg-primary" href="@detailUrl" role="button" tabindex="0" aria-label="@item.AccessibleName" data-calendar-event="true" data-status="@item.Status" title="@item.Label - @item.StatusLabel - @item.WorkingDays días">
                      <span>Solicitud</span>
                      <span class="visually-hidden">@item.Label @item.StatusLabel @item.WorkingDays días</span>
                    </a>
                  }
                  else
                  {
                    <span class="nl-event text-bg-primary" role="button" tabindex="0" aria-label="@item.AccessibleName" data-calendar-event="true" data-status="@item.Status" title="@item.Label - @item.StatusLabel - @item.WorkingDays días">
                      <span>Solicitud</span>
                      <span class="visually-hidden">@item.Label @item.StatusLabel @item.WorkingDays días</span>
                    </span>
                  }
                }
                @if (day.Events.Count > 2)
                {
                  <span class="small text-body-secondary">+@(day.Events.Count - 2) mas</span>
                }
              </div>
            </td>
          }
        </tr>
      }
    </tbody>
  </table>
  </div>

  @if (Model.Events.Count == 0)
  {
    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
      <i class="bi bi-info-circle" aria-hidden="true"></i>
      <span>No hay periodos aprobados en este mes.</span>
    </div>
  }
  else
  {
    <div class="nl-card p-3">
      <h3 class="h6">Eventos autorizados</h3>
      <ul class="list-group list-group-flush">
        @foreach (var item in Model.Events)
        {
          var detailUrl = item.DetailUrl(Model.DetailRouteTemplate);
          <li class="list-group-item d-flex flex-column flex-md-row justify-content-between gap-2" data-status="@item.Status">
            <span>
              <span>@item.Label</span>
              @if (!string.IsNullOrWhiteSpace(item.RequesterName))
              {
                <span> - @item.RequesterName</span>
              }
              <span> - @item.StartDate.ToString("yyyy-MM-dd") a @item.EndDate.ToString("yyyy-MM-dd")</span>
              <span class="badge border @item.StatusCssClass">@item.StatusLabel</span>
            </span>
            @if (detailUrl is not null)
            {
              <a class="btn btn-sm btn-outline-primary align-self-start" href="@detailUrl" aria-label="@item.AccessibleName" data-calendar-event="true">Ver detalle</a>
            }
          </li>
        }
      </ul>
    </div>
  }
</section>
