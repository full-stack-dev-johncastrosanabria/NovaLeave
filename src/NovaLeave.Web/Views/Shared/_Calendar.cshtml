@model NovaLeave.Application.Calendars.CalendarViewModel

@functions {
    private static IReadOnlyList<IReadOnlyList<NovaLeave.Application.Calendars.CalendarDay>> Weeks(IReadOnlyList<NovaLeave.Application.Calendars.CalendarDay> days)
    {
        return days
            .Select((day, index) => new { day, index })
            .GroupBy(item => item.index / 7)
            .Select(group => group.Select(item => item.day).ToList())
            .ToList();
    }
}
@{
    var previous = Model.CurrentMonth.FirstDay.AddMonths(-1);
    var next = Model.CurrentMonth.FirstDay.AddMonths(1);
    var route = Model.CurrentRole == NovaLeave.Application.Calendars.RoleContext.HR ? "/rrhh/calendario" : "/calendario";
    var context = Model.CurrentRole == NovaLeave.Application.Calendars.RoleContext.HR ? string.Empty : $"&context={Model.CurrentRole}";
    var today = DateTime.UtcNow;
}

<section class="nl-card" aria-label="@Model.Title">
  <div class="nl-card-body">
  <div class="nl-calendar-header mb-3">
    <div>
      <h2 class="h5 mb-1">@Model.CurrentMonth.DisplayName</h2>
      <p class="text-body-secondary mb-0">@Model.Title</p>
    </div>
    <div class="btn-group" role="group" aria-label="Navegación del calendario">
      <a class="btn btn-outline-primary" href="@route?year=@previous.Year&month=@previous.Month@context" aria-label="Mes anterior">Anterior</a>
      <a class="btn btn-outline-primary" href="@route?year=@today.Year&month=@today.Month@context">Hoy</a>
      <a class="btn btn-outline-primary" href="@route?year=@next.Year&month=@next.Month@context" aria-label="Mes siguiente">Siguiente</a>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2 mb-3" aria-label="Leyenda de calendario">
    @foreach (var category in Model.Events.Select(item => item.CategoryLabel).Distinct())
    {
      <span class="nl-badge nl-badge-neutral">@category</span>
    }
    <span class="nl-badge nl-badge-approved">Aprobada</span>
    <span class="nl-badge nl-badge-pending">Pendiente</span>
  </div>

  <div class="table-responsive">
  <table class="table nl-table nl-calendar align-middle calendar-grid" role="grid" aria-label="@Model.Title" data-calendar-keyboard="true">
    <caption>@Model.Title</caption>
    <thead>
      <tr>
        <th scope="col"><abbr title="Lunes">Lun</abbr></th>
        <th scope="col"><abbr title="Martes">Mar</abbr></th>
        <th scope="col"><abbr title="Miercoles">Mie</abbr></th>
        <th scope="col"><abbr title="Jueves">Jue</abbr></th>
        <th scope="col"><abbr title="Viernes">Vie</abbr></th>
        <th scope="col"><abbr title="Sabado">Sab</abbr></th>
        <th scope="col"><abbr title="Domingo">Dom</abbr></th>
      </tr>
    </thead>
    <tbody>
      @foreach (var week in Weeks(Model.Days))
      {
        <tr role="row">
          @foreach (var day in week)
          {
            var dayClass = day.IsWeekend || !day.IsCurrentMonth ? "nl-calendar-day-muted" : string.Empty;
            <td class="nl-calendar-day @dayClass" role="gridcell" aria-label="@day.Date.ToString("yyyy-MM-dd")" tabindex="@(day.IsWeekend ? "-1" : "0")">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <span class="fw-semibold @(day.IsToday ? "nl-calendar-today" : string.Empty)">@day.Date.Day</span>
                @if (day.IsWeekend)
                {
                  <span class="visually-hidden">Fin de semana</span>
                }
              </div>
              <div class="d-grid gap-1 mt-2">
                @foreach (var item in day.Events.Take(3))
                {
                  var detailUrl = item.DetailUrl(Model.DetailRouteTemplate);
                  if (detailUrl is not null)
                  {
                    <a class="nl-calendar-event @item.CategoryCssClass" href="@detailUrl" role="button" tabindex="0" aria-label="@item.AccessibleName" data-calendar-event="true" data-status="@item.Status" data-category="@item.Category">
                      <strong>@item.StatusLabel</strong>
                      <span>@item.WorkingDays días · @item.StartDate.ToString("dd/MM")–@item.EndDate.ToString("dd/MM")</span>
                    </a>
                  }
                  else
                  {
                    <span class="nl-calendar-event @item.CategoryCssClass" role="button" tabindex="0" aria-label="@item.AccessibleName" data-calendar-event="true" data-status="@item.Status" data-category="@item.Category">
                      <strong>@item.StatusLabel</strong>
                      <span>@item.WorkingDays días · @item.StartDate.ToString("dd/MM")–@item.EndDate.ToString("dd/MM")</span>
                    </span>
                  }
                }
                @if (day.Events.Count > 3)
                {
                  <span class="small text-body-secondary">+@(day.Events.Count - 3) mas</span>
                }
              </div>
            </td>
          }
        </tr>
      }
    </tbody>
  </table>
  </div>

  @if (Model.Events.Count == 0)
  {
    <div class="nl-empty" role="status"><strong>No hay eventos en este mes.</strong><span>Cambie de mes para consultar otros periodos.</span></div>
  }
  else
  {
    <div class="nl-calendar-list mt-4">
      <h3 class="h6">Eventos autorizados</h3>
      <ul class="list-group">
        @foreach (var item in Model.Events)
        {
          var detailUrl = item.DetailUrl(Model.DetailRouteTemplate);
          <li class="list-group-item d-flex flex-column flex-md-row justify-content-between gap-2" data-status="@item.Status" data-category="@item.Category">
            <span>
              <span class="fw-semibold">@item.CategoryLabel</span>
              <span>@item.Label</span>
              @if (!string.IsNullOrWhiteSpace(item.RequesterName))
              {
                <span> - @item.RequesterName</span>
              }
              <span> · @item.StartDate.ToString("dd/MM/yyyy") al @item.EndDate.ToString("dd/MM/yyyy") · @item.WorkingDays días</span>
              <partial name="_StatusBadge" model="item.StatusLabel" />
            </span>
            @if (detailUrl is not null)
            {
              <a class="btn btn-sm btn-outline-primary align-self-start" href="@detailUrl" aria-label="@item.AccessibleName" data-calendar-event="true">Ver detalle</a>
            }
          </li>
        }
      </ul>
    </div>
  }
  </div>
</section>
