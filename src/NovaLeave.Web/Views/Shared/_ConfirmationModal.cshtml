<div class="modal fade nl-confirmation-modal" id="nlConfirmationModal" tabindex="-1" aria-labelledby="nlConfirmationTitle" aria-describedby="nlConfirmationMessage" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <p class="nl-page-kicker mb-1">Confirmación</p>
          <h2 class="modal-title h5" id="nlConfirmationTitle">Confirmar operación</h2>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body" id="nlConfirmationMessage">Revise la operación antes de continuar.</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-primary" data-confirm-submit>Confirmar</button>
      </div>
    </div>
  </div>
</div>
