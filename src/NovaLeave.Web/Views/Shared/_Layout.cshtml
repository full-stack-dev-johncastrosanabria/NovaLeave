@{
    var path = Context.Request.Path.Value ?? "/";
    var hasUserContext = User.IsInRole("User");
    var hasApproverContext = User.IsInRole("Approver") && User.HasClaim("CanResolveRequests", "true");
    var hasHrContext = User.IsInRole("HR");
    var contextCount = (hasUserContext ? 1 : 0) + (hasApproverContext ? 1 : 0) + (hasHrContext ? 1 : 0);
    var requestedContext = Context.Request.Query["context"].ToString();
    var parsedCalendarContext = NovaLeave.Application.Calendars.RoleContext.User;
    var hasExplicitCalendarContext = path.Equals("/calendario", StringComparison.OrdinalIgnoreCase)
        && Enum.TryParse<NovaLeave.Application.Calendars.RoleContext>(requestedContext, true, out parsedCalendarContext)
        && parsedCalendarContext is NovaLeave.Application.Calendars.RoleContext.User or NovaLeave.Application.Calendars.RoleContext.Approver;
    var activeContext = path.StartsWith("/rrhh", StringComparison.OrdinalIgnoreCase)
        ? NovaLeave.Application.Calendars.RoleContext.HR
        : path.StartsWith("/aprobaciones", StringComparison.OrdinalIgnoreCase)
            ? NovaLeave.Application.Calendars.RoleContext.Approver
            : hasExplicitCalendarContext
                ? parsedCalendarContext
                : path.Equals("/calendario", StringComparison.OrdinalIgnoreCase) && !hasUserContext && hasApproverContext
                    ? NovaLeave.Application.Calendars.RoleContext.Approver
                    : NovaLeave.Application.Calendars.RoleContext.User;
    var activeRoot = activeContext == NovaLeave.Application.Calendars.RoleContext.HR && hasHrContext
        ? "/rrhh"
        : activeContext == NovaLeave.Application.Calendars.RoleContext.Approver && hasApproverContext
            ? "/aprobaciones"
            : "/mis-solicitudes";
    var activeContextLabel = activeContext == NovaLeave.Application.Calendars.RoleContext.HR
        ? "RRHH"
        : activeContext == NovaLeave.Application.Calendars.RoleContext.Approver
            ? "Aprobaciones"
            : "Mi espacio";
}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - NovaLeave</title>
  <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <div class="nl-shell">
  <header class="nl-topbar">
    <nav class="navbar navbar-expand-lg" aria-label="Navegacion principal">
      <div class="container">
        <a class="navbar-brand d-inline-flex align-items-center gap-2 fw-bold" href="@activeRoot">
          <span class="nl-brand-mark" aria-hidden="true">N</span>
          <span>NovaLeave</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <span class="nl-context-chip d-none d-md-inline-flex" aria-label="Contexto activo">@activeContextLabel</span>
        }
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Abrir navegacion">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavigation">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            @if (hasUserContext && activeContext == NovaLeave.Application.Calendars.RoleContext.User)
            {
              <li class="nav-item"><a class="nav-link @(path.Equals("/mis-solicitudes", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/mis-solicitudes">Mi historial</a></li>
              <li class="nav-item"><a class="nav-link" href="/mis-solicitudes/crear">Nueva solicitud</a></li>
              <li class="nav-item"><a class="nav-link @(path.Equals("/saldo", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/saldo">Mi saldo</a></li>
              <li class="nav-item"><a class="nav-link @(path.Equals("/calendario", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/calendario?context=User">Calendario</a></li>
            }
            @if (hasApproverContext && activeContext == NovaLeave.Application.Calendars.RoleContext.Approver)
            {
              <li class="nav-item"><a class="nav-link @(path.Equals("/aprobaciones", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/aprobaciones">Aprobaciones</a></li>
              <li class="nav-item"><a class="nav-link @(path.Equals("/aprobaciones/historial", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/aprobaciones/historial">Historial</a></li>
              <li class="nav-item"><a class="nav-link @(path.Equals("/calendario", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/calendario?context=Approver">Calendario</a></li>
            }
            @if (hasHrContext && activeContext == NovaLeave.Application.Calendars.RoleContext.HR)
            {
              <li class="nav-item"><a class="nav-link @(path.Equals("/rrhh", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/rrhh">Inicio</a></li>
              <li class="nav-item"><a class="nav-link @(path.StartsWith("/rrhh/solicitudes", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/rrhh/solicitudes">Solicitudes</a></li>
              <li class="nav-item"><a class="nav-link @(path.StartsWith("/rrhh/calendario", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/rrhh/calendario">Calendario organizacional</a></li>
              <li class="nav-item"><a class="nav-link @(path.StartsWith("/rrhh/saldos", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/rrhh/saldos">Saldos</a></li>
              <li class="nav-item"><a class="nav-link @(path.StartsWith("/rrhh/auditoria", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/rrhh/auditoria">Auditoria</a></li>
              <li class="nav-item"><a class="nav-link @(path.StartsWith("/rrhh/aprobadores", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)" href="/rrhh/aprobadores">Aprobadores</a></li>
            }
          </ul>
          @if (User.Identity?.IsAuthenticated == true)
          {
            <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2">
              @if (contextCount > 1)
              {
                <div class="dropdown">
                  <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Mis roles</button>
                  <ul class="dropdown-menu dropdown-menu-end">
                  @if (hasUserContext)
                  {
                    <li><a class="dropdown-item" href="/mis-solicitudes">Mi espacio</a></li>
                  }
                  @if (hasApproverContext)
                  {
                    <li><a class="dropdown-item" href="/aprobaciones">Aprobaciones</a></li>
                  }
                  @if (hasHrContext)
                  {
                    <li><a class="dropdown-item" href="/rrhh">RRHH</a></li>
                  }
                  </ul>
                </div>
              }
              <div class="dropdown">
                <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menu de usuario">
                  @(User.Identity.Name ?? "Usuario")
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><span class="dropdown-item-text text-body-secondary">@(User.Identity.Name ?? "Usuario autenticado")</span></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <form method="post" asp-area="Identity" asp-page="/Account/Logout">
                      <button type="submit" class="dropdown-item">Cerrar sesion</button>
                    </form>
                  </li>
                </ul>
              </div>
            </div>
          }
        </div>
      </div>
    </nav>
  </header>
  <main class="nl-main" role="main">
    <div class="container">
    @RenderBody()
    @await Html.PartialAsync("_Toast", TempData["Toast"]?.ToString() ?? string.Empty)
    </div>
  </main>
  <footer class="border-top py-3 bg-white">
    <div class="container small text-secondary">NovaLeave</div>
  </footer>
  <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
  </div>
</body>
</html>
