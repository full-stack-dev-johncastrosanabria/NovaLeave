<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - NovaLeave</title>
  <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
</head>
<body>
  <header class="border-bottom">
    <nav class="navbar navbar-expand-lg bg-body">
      <div class="container">
        <a class="navbar-brand" href="/mis-solicitudes">NovaLeave</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Abrir navegacion">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavigation">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item"><a class="nav-link" href="/mis-solicitudes">Mis solicitudes</a></li>
            <li class="nav-item"><a class="nav-link" href="/aprobaciones">Aprobaciones</a></li>
            <li class="nav-item"><a class="nav-link" href="/saldo">Mi saldo</a></li>
            <li class="nav-item"><a class="nav-link" href="/calendario">Mi calendario</a></li>
          </ul>
          <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Mis roles</button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/mis-solicitudes">Usuario</a></li>
              <li><a class="dropdown-item" href="/aprobaciones">Aprobador</a></li>
              <li><a class="dropdown-item" href="/rrhh">RRHH</a></li>
            </ul>
          </div>
        </div>
      </div>
    </nav>
  </header>
  <main class="container py-4" role="main">
    @RenderBody()
  </main>
  <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
