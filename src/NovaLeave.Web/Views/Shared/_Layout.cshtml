@{
    // Navigation is derived from the authenticated identity's roles (RBFV 4.1, 5.x, 7.x).
    // It is a usability affordance only: every route is still authorized server-side, and
    // hiding a link is never treated as a security control (constitution 7.1).
    var currentUser = User;
    var isAuthenticated = currentUser?.Identity?.IsAuthenticated ?? false;
    var isUser = isAuthenticated && currentUser!.IsInRole("User");
    var isApprover = isAuthenticated && currentUser!.IsInRole("Approver");
    var isHR = isAuthenticated && currentUser!.IsInRole("HR");

    // Only an Approver whose capability is enabled may reach the approver context
    // (constitution 4.2; RBFV 5.2 for /calendario).
    var canResolve = isApprover && currentUser!.HasClaim("CanResolveRequests", "true");

    // "Mis roles" lists only contexts the identity actually holds, and is hidden below two
    // contexts (RBFV 4.2 display condition, RBFV-020).
    var contexts = new List<(string Key, string Label, string Href)>();
    if (isUser) { contexts.Add(("user", "Mi espacio", "/mis-solicitudes")); }
    if (isApprover) { contexts.Add(("approver", "Aprobaciones", "/aprobaciones")); }
    if (isHR) { contexts.Add(("hr", "RRHH", "/rrhh")); }
    var showContextSwitcher = contexts.Count >= 2;

    // Each context owns its navigation bar (RBFV 7.1, 7.2, 7.3); the active one is derived from
    // the current route prefix, so switching context changes only the prefix and the visible
    // navigation. Notably the RRHH context links the calendar to /rrhh/calendario and never to
    // the shared /calendario, which carries no HR behaviour (RBFV 7.3).
    var path = Context.Request.Path.Value ?? string.Empty;
    var activeContext =
        isHR && path.StartsWith("/rrhh", StringComparison.OrdinalIgnoreCase) ? "hr"
        : isApprover && path.StartsWith("/aprobaciones", StringComparison.OrdinalIgnoreCase) ? "approver"
        : contexts.Count > 0 ? contexts[0].Key
        : string.Empty;

    var navItems = new List<(string Label, string Href, string Icon)>();
    switch (activeContext)
    {
        case "hr":
            navItems.Add(("Solicitudes", "/rrhh/solicitudes", "bi-inbox"));
            navItems.Add(("Calendario", "/rrhh/calendario", "bi-calendar3"));
            navItems.Add(("Saldos", "/rrhh/saldos", "bi-wallet2"));
            navItems.Add(("Auditoria", "/rrhh/auditoria", "bi-shield-check"));
            navItems.Add(("Aprobadores", "/rrhh/aprobadores", "bi-person-badge"));
            break;
        case "approver":
            navItems.Add(("Pendientes", "/aprobaciones", "bi-inbox"));
            navItems.Add(("Historial", "/aprobaciones/historial", "bi-clock-history"));
            // The scope is selected explicitly: without it an identity holding both User and
            // Approver falls back to its personal scope and the approver calendar looks empty.
            if (canResolve) { navItems.Add(("Calendario", "/calendario?context=Approver", "bi-calendar3")); }
            break;
        case "user":
            navItems.Add(("Mis solicitudes", "/mis-solicitudes", "bi-journal-text"));
            navItems.Add(("Mi historial", "/saldo", "bi-wallet2"));
            navItems.Add(("Calendario", "/calendario?context=User", "bi-calendar3"));
            break;
    }

    var contextLabel = contexts.FirstOrDefault(c => c.Key == activeContext).Label ?? "NovaLeave";
    var brandHref = contexts.FirstOrDefault(c => c.Key == activeContext).Href ?? "/";

    // Mark the current item so the active page is obvious without relying on colour alone.
    bool IsActive(string href)
    {
        var target = href.Split('?')[0];
        return target == "/"
            ? path == "/"
            : path.Equals(target, StringComparison.OrdinalIgnoreCase)
              || path.StartsWith(target + "/", StringComparison.OrdinalIgnoreCase);
    }
}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - NovaLeave</title>
  @* CoreUI 5.9 is built on Bootstrap 5.3 and supersedes the base stylesheet: loading both
     would duplicate and conflict. Every Bootstrap utility and component class still applies.
     All assets are self-hosted and version-pinned in libman.json (constitution §7.2, §11.2). *@
  <link rel="stylesheet" href="~/lib/coreui/css/coreui.min.css" />
  <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/novaleave.css" />
</head>
<body>
@if (!isAuthenticated)
{
  <main class="container py-5" role="main">
    @RenderBody()
  </main>
}
else
{
  @* Keyboard users reach content without traversing the whole navigation rail. *@
  <a class="nl-skip" href="#contenido">Saltar al contenido</a>

  <div class="nl-shell">
    <aside class="nl-sidebar" id="nlSidebar">
      <a class="nl-brand" href="@brandHref">
        <i class="bi bi-calendar2-check" aria-hidden="true"></i>
        <span>NovaLeave</span>
      </a>

      <nav class="nav flex-column" aria-label="Navegacion principal">
        <div class="nl-nav-section">@contextLabel</div>
        @foreach (var item in navItems)
        {
          var active = IsActive(item.Href);
          <a class="nav-link @(active ? "active" : null)" href="@item.Href" @(active ? "aria-current=page" : null)>
            <i class="bi @item.Icon" aria-hidden="true"></i>
            <span>@item.Label</span>
          </a>
        }
      </nav>

      <div class="nl-sidebar-footer">
        <div class="nl-user text-truncate">@currentUser!.Identity!.Name</div>
        <div>Sesion activa</div>
      </div>
    </aside>

    <div class="nl-main">
      <header class="nl-header">
        <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" id="nlSidebarToggle" aria-controls="nlSidebar" aria-expanded="false" aria-label="Abrir navegacion">
          <i class="bi bi-list" aria-hidden="true"></i>
        </button>

        <h1 class="nl-page-title text-truncate mb-0">@ViewData["Title"]</h1>

        <div class="ms-auto d-flex align-items-center gap-2">
          @if (showContextSwitcher)
          {
            <div class="dropdown">
              <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" id="misRoles" data-coreui-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="bi bi-people" aria-hidden="true"></i>
                <span class="d-none d-sm-inline ms-1">Mis roles</span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="misRoles">
                @foreach (var context in contexts)
                {
                  <li>
                    <a class="dropdown-item @(context.Key == activeContext ? "active" : null)" href="@context.Href" @(context.Key == activeContext ? "aria-current=true" : null)>
                      @context.Label
                    </a>
                  </li>
                }
              </ul>
            </div>
          }
          <form method="post" action="/Identity/Account/Logout" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-secondary">
              <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
              <span class="d-none d-sm-inline ms-1">Cerrar sesion</span>
            </button>
          </form>
        </div>
      </header>

      <main class="nl-content" role="main" id="contenido" tabindex="-1">
        @RenderBody()
      </main>
    </div>
  </div>
}

  <script src="~/lib/coreui/js/coreui.bundle.min.js"></script>
  <script src="~/lib/htmx/htmx.min.js"></script>
  <script>
    // Offcanvas sidebar for narrow viewports.
    (function () {
      var toggle = document.getElementById('nlSidebarToggle');
      var sidebar = document.getElementById('nlSidebar');
      if (!toggle || !sidebar) { return; }
      var backdrop;
      function close() {
        sidebar.classList.remove('show');
        toggle.setAttribute('aria-expanded', 'false');
        if (backdrop) { backdrop.remove(); backdrop = null; }
      }
      toggle.addEventListener('click', function () {
        var open = sidebar.classList.toggle('show');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) {
          backdrop = document.createElement('div');
          backdrop.className = 'nl-backdrop';
          backdrop.addEventListener('click', close);
          document.body.appendChild(backdrop);
        } else { close(); }
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { close(); } });
    })();
  </script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
