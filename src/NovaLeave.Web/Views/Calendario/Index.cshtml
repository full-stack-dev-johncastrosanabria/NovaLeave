@model NovaLeave.Web.ViewModels.Calendario.CalendarioViewModel
@{
    ViewData["Title"] = "Mi calendario";
}

<h1 class="h3 mb-1">Mi calendario</h1>
<p class="text-body-secondary">Calendario de vacaciones aprobadas.</p>

<div class="table-responsive">
  <table class="table table-striped align-middle">
    <caption>Calendario de vacaciones</caption>
    <thead>
      <tr>
        <th scope="col">Inicio</th>
        <th scope="col">Fin</th>
        <th scope="col">Dias habiles</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var item in Model.Events)
      {
        <tr>
          <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
          <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
          <td>@item.WorkingDays</td>
        </tr>
      }
    </tbody>
  </table>
</div>
