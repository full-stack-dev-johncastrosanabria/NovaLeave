@model NovaLeave.Web.ViewModels.RRHH.RRHHAuditoriaViewModel
@{
    ViewData["Title"] = "Auditoría RRHH";
}

<section class="nl-page-intro" aria-label="Alcance de la vista">
  <div>
    <span class="nl-eyebrow">Registro de actividad</span>
    <p>Consulta quién realizó cada acción, cuándo ocurrió y cuál fue su resultado.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/rrhh">Volver</a>
</section>

<div class="nl-card">
<div class="nl-card-header"><h2>Eventos auditados</h2><span class="nl-result-count">@Model.Records.TotalCount registro@(Model.Records.TotalCount == 1 ? "" : "s")</span></div>
@if (!Model.Records.Items.Any())
{
  <div class="nl-empty"><i class="bi bi-shield-check" aria-hidden="true"></i><p class="mb-0">No hay eventos de auditoría para mostrar.</p></div>
}
else
{
<div class="table-responsive">
  <table class="table nl-table align-middle">
    <caption class="visually-hidden">Registros de auditoría relevantes para RRHH</caption>
    <thead>
      <tr>
        <th scope="col">Fecha</th>
        <th scope="col">Actor</th>
        <th scope="col">Rol</th>
        <th scope="col">Acción</th>
        <th scope="col">Entidad</th>
        <th scope="col">Resultado</th>
        <th scope="col">Datos</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var record in Model.Records.Items)
      {
        <tr>
          <td>@record.TimestampUtc</td>
          <td>@record.ActorId</td>
          <td>@record.ActorRole</td>
          <td>@record.Action</td>
          <td>@record.EntityType @record.EntityId</td>
          <td>@record.Result</td>
          <td>@record.Data</td>
        </tr>
      }
    </tbody>
  </table>
</div>
}
</div>

<p class="text-body-secondary nl-result-count">Página @Model.Records.Page de @Model.Records.TotalPages</p>
