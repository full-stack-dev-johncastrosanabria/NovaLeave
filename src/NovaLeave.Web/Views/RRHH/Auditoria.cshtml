@model NovaLeave.Web.ViewModels.RRHH.RRHHAuditoriaViewModel
@{
    ViewData["Title"] = "Auditoria RRHH";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">RRHH</p>
    <h1 class="nl-page-title">Auditoria</h1>
    <p class="nl-page-description">Registros relevantes para consulta de RRHH.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <span class="nl-badge nl-readonly">Solo lectura</span>
    <a class="btn btn-outline-secondary" href="/rrhh">Volver</a>
  </div>
</div>

<section class="nl-card">
  <div class="nl-card-body">
<form method="get" class="nl-filter-bar mb-3"><div><label class="form-label" for="action">Acción</label><input class="form-control" id="action" name="action" value="@Context.Request.Query["action"]" placeholder="Ej. Approve" /></div><button class="btn btn-outline-primary" type="submit">Aplicar filtro</button></form>
<div class="table-responsive">
  <table class="table nl-table nl-responsive-table align-middle">
    <caption>Registros de auditoria relevantes para RRHH</caption>
    <thead>
      <tr>
        <th scope="col">Fecha</th>
        <th scope="col">Actor</th>
        <th scope="col">Rol</th>
        <th scope="col">Accion</th>
        <th scope="col">Entidad</th>
        <th scope="col">Resultado</th>
        <th scope="col">Datos</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var record in Model.Records.Items)
      {
        <tr>
          <td data-label="Fecha">@record.TimestampUtc.ToString("dd/MM/yyyy HH:mm")</td>
          <td data-label="Actor"><strong>@record.ActorName</strong></td>
          <td data-label="Rol">@record.ActorRole</td>
          <td data-label="Acción">@record.Action</td>
          <td data-label="Entidad">@record.EntityType</td>
          <td data-label="Resultado">@record.Result</td>
          <td data-label="Detalle"><span class="text-body-secondary">@(string.IsNullOrWhiteSpace(record.Data) ? "Sin detalle adicional" : "Información operativa protegida")</span></td>
        </tr>
      }
    </tbody>
  </table>
</div>
  </div>
</section>

<p class="text-body-secondary">Pagina @Model.Records.Page de @Math.Max(1, (int)Math.Ceiling(Model.Records.TotalCount / (double)Model.Records.PageSize))</p>
