@model NovaLeave.Web.ViewModels.RRHH.RRHHSaldosIndexViewModel
@{
    ViewData["Title"] = "Saldos RRHH";
}

<div class="nl-page-header nl-page-header-card">
  <div class="nl-heading-group"><span class="nl-heading-icon"><partial name="_Icon" model="@("briefcase")" /></span><div><h1 class="nl-page-title">Saldos de Vacaciones Organizacionales (RRHH)</h1><p class="nl-page-description">Resumen consolidado de saldos devengados, reservados y disfrutados por colaborador.</p></div></div>
  <span class="nl-badge nl-readonly">Solo Lectura (Modificación de saldos deshabilitada)</span>
</div>

<section class="nl-card"><div class="nl-card-body">
  <div class="nl-section-heading"><h2 class="h5 mb-0">Colaboradores Registrados: <strong class="text-primary">@Model.Balances.TotalCount</strong></h2></div>
  <div class="table-responsive"><table class="table nl-table nl-responsive-table align-middle"><caption>Saldos globales de vacaciones</caption><thead><tr><th scope="col">Colaborador</th><th scope="col">Acumulado total</th><th scope="col">Pendientes</th><th scope="col">Días gozados</th><th scope="col">Disponible</th><th scope="col">Acciones</th></tr></thead><tbody>
  @foreach (var balance in Model.Balances.Items)
  {
    <tr><td data-label="Colaborador"><strong>@balance.UserName</strong></td><td data-label="Acumulado total"><strong class="text-primary">@balance.AccruedDays días</strong></td><td data-label="Pendientes"><strong class="text-warning">@balance.ReservedDays días</strong></td><td data-label="Días gozados"><strong class="text-success">@balance.DeductedDays días</strong></td><td data-label="Disponible"><strong>@balance.AvailableDays días</strong></td><td data-label="Acciones"><a class="btn btn-sm btn-light" href="/rrhh/saldos/@balance.UserId"><partial name="_Icon" model="@("eye")" />Cronología</a></td></tr>
  }
  </tbody></table></div>
</div></section>

@if (Model.Balances.TotalCount > Model.Balances.PageSize)
{
  <p class="text-body-secondary mt-3">Página @Model.Balances.Page de @Math.Max(1, (int)Math.Ceiling(Model.Balances.TotalCount / (double)Model.Balances.PageSize))</p>
}
