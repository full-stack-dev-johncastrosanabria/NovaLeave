@model NovaLeave.Web.ViewModels.RRHH.RRHHDashboardViewModel
@{
    ViewData["Title"] = "RRHH";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">RRHH</p>
    <h1 class="nl-page-title">Inicio</h1>
    <p class="nl-page-description">Herramientas organizacionales de consulta y control autorizado.</p>
  </div>
  <span class="nl-badge nl-readonly">Solo lectura</span>
</div>

<div class="nl-summary-grid mb-4">
  <section class="nl-card nl-summary-card"><div class="nl-summary-label">Solicitudes pendientes</div><div class="nl-summary-value">@Model.PendingRequests</div></section>
  <section class="nl-card nl-summary-card"><div class="nl-summary-label">Vacaciones aprobadas próximas</div><div class="nl-summary-value">@Model.UpcomingApprovedRequests</div></section>
  <section class="nl-card nl-summary-card"><div class="nl-summary-label">Saldos disponibles</div><div class="nl-summary-value">@Model.BalanceCount</div></section>
  <section class="nl-card nl-summary-card"><div class="nl-summary-label">Aprobadores habilitados</div><div class="nl-summary-value">@Model.EnabledApprovers</div><div class="small text-body-secondary">@Model.DisabledApprovers deshabilitados</div></section>
</div>

<div class="nl-module-grid">
  <a class="nl-card nl-module-card" href="/rrhh/solicitudes"><span class="nl-page-kicker">Solicitudes</span><h2>Solicitudes organizacionales</h2><p>Consulte estados, fechas y detalle de cada solicitud.</p><span>Ver solicitudes</span></a>
  <a class="nl-card nl-module-card" href="/rrhh/calendario"><span class="nl-page-kicker">Calendario</span><h2>Calendario organizacional</h2><p>Revise periodos de vacaciones por mes.</p><span>Abrir calendario</span></a>
  <a class="nl-card nl-module-card" href="/rrhh/saldos"><span class="nl-page-kicker">Saldos</span><h2>Saldos y movimientos</h2><p>Consulte los cuatro valores autorizados por persona.</p><span>Ver saldos</span></a>
  <a class="nl-card nl-module-card" href="/rrhh/auditoria"><span class="nl-page-kicker">Auditoría</span><h2>Registro de auditoría</h2><p>Revise eventos relevantes con información protegida.</p><span>Ver auditoría</span></a>
  <a class="nl-card nl-module-card" href="/rrhh/aprobadores"><span class="nl-page-kicker">Gestión limitada</span><h2>Capacidad de aprobadores</h2><p>Habilite o deshabilite la capacidad de resolución.</p><span>Gestionar capacidad</span></a>
</div>
