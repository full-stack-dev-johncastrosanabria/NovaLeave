@model NovaLeave.Web.ViewModels.RRHH.RRHHDashboardViewModel
@{
    ViewData["Title"] = "Resumen de vacaciones";
}

@* Read-only overview. HR has organization-wide read access and no write capability here beyond
   approver-capability management, which lives on its own page (constitution §4.3). *@

<section class="nl-page-intro" aria-label="Alcance del panel">
  <div>
    <span class="nl-eyebrow">Resumen organizacional</span>
    <p>Consulta las solicitudes que requieren atención, los saldos disponibles y los últimos cambios registrados.</p>
  </div>
</section>

<div class="row g-3">
  <div class="col-6 col-lg-3">
    <div class="nl-card h-100 nl-stat nl-stat-accent">
      <div class="nl-stat-label">
        <i class="bi bi-hourglass-split" aria-hidden="true"></i>
        <span>Solicitudes por resolver</span>
      </div>
      <div class="nl-stat-value">@Model.PendingRequests</div>
      <div class="nl-stat-hint">Pendientes de aprobación</div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="nl-card h-100 nl-stat">
      <div class="nl-stat-label">
        <i class="bi bi-journal-text" aria-hidden="true"></i>
        <span>Solicitudes registradas</span>
      </div>
      <div class="nl-stat-value">@Model.TotalRequests</div>
      <div class="nl-stat-hint">Total en el historial</div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="nl-card h-100 nl-stat">
      <div class="nl-stat-label">
        <i class="bi bi-people" aria-hidden="true"></i>
        <span>Personas con saldo</span>
      </div>
      <div class="nl-stat-value">@Model.TotalEmployees</div>
      <div class="nl-stat-hint">@Model.ApproversAbleToResolve de @Model.ApproverCount aprobadores habilitados</div>
    </div>
  </div>

  <div class="col-6 col-lg-3">
    <div class="nl-card h-100 nl-stat">
      <div class="nl-stat-label">
        <i class="bi bi-wallet2" aria-hidden="true"></i>
        <span>Saldo disponible total</span>
      </div>
      <div class="nl-stat-value">@Model.TotalAvailableDays</div>
      <div class="nl-stat-hint">@Model.TotalReservedDays reservados &middot; @Model.TotalDeductedDays descontados</div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="nl-card h-100">
      <div class="nl-card-header">
        <h2>Solicitudes que requieren atención</h2>
        <a class="btn btn-sm btn-outline-primary" href="/rrhh/solicitudes">Consultar todas</a>
      </div>

      @if (!Model.RecentRequests.Any())
      {
        <div class="nl-empty">
          <i class="bi bi-inbox" aria-hidden="true"></i>
          <p class="mb-0">Todavía no hay solicitudes en la organización.</p>
        </div>
      }
      else
      {
        <div class="table-responsive">
          <table class="table nl-table align-middle">
            <caption class="visually-hidden">Solicitudes más recientes de la organización</caption>
            <thead>
              <tr>
                <th scope="col">Persona</th>
                <th scope="col">Período</th>
                <th scope="col" class="text-end">Días</th>
                <th scope="col">Estado</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var request in Model.RecentRequests)
              {
                <tr>
                  <td class="text-truncate" style="max-width:12rem">
                    <a href="/rrhh/solicitudes/@request.Id">@request.RequesterName</a>
                  </td>
                  <td>@request.StartDate.ToString("yyyy-MM-dd") &rarr; @request.EndDate.ToString("yyyy-MM-dd")</td>
                  <td class="text-end">@request.WorkingDays</td>
                  <td>@await Html.PartialAsync("_StatusBadge", request.Status.ToString())</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
  </div>

  <div class="col-lg-5">
    <div class="nl-card h-100">
      <div class="nl-card-header">
        <h2>Estado de las solicitudes</h2>
      </div>
      <div class="p-3">
        @{
            var breakdown = new (string Label, int Value, string Css, string Icon)[]
            {
                ("Pendientes", Model.PendingRequests, "bg-warning", "bi-hourglass-split"),
                ("Aprobadas", Model.ApprovedRequests, "bg-success", "bi-check-circle-fill"),
                ("Rechazadas", Model.RejectedRequests, "bg-danger", "bi-x-circle-fill"),
                ("Canceladas", Model.CancelledRequests, "bg-secondary", "bi-slash-circle")
            };
            var maxValue = Math.Max(1, breakdown.Max(item => item.Value));
        }

        @if (!Model.HasRequests)
        {
          <p class="text-body-secondary mb-0">Sin datos que mostrar todavía.</p>
        }
        else
        {
          @* Each bar states its own figure, so the chart never depends on length or colour
             alone to be readable. *@
          <ul class="list-unstyled mb-3">
            @foreach (var item in breakdown)
            {
              <li class="mb-2">
                <div class="d-flex justify-content-between align-items-center" style="font-size:13px">
                  <span class="nl-status">
                    <i class="bi @item.Icon text-body-secondary" aria-hidden="true"></i>
                    <span>@item.Label</span>
                  </span>
                  <span class="nl-num fw-semibold">@item.Value</span>
                </div>
                <div class="progress mt-1" style="height:6px"
                     role="img"
                     aria-label="@item.Label: @item.Value de @Model.TotalRequests solicitudes">
                  <div class="progress-bar @item.Css" style="width:@(item.Value * 100 / maxValue)%"></div>
                </div>
              </li>
            }
          </ul>

          <div class="d-flex justify-content-between align-items-center pt-2 border-top">
            <span class="nl-stat-label mb-0">Tasa de aprobación</span>
            <span class="nl-num fw-semibold">@Model.ApprovalRatePercent%</span>
          </div>
        }
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="nl-card h-100">
      <div class="nl-card-header">
        <h2>Últimos cambios registrados</h2>
        <a class="btn btn-sm btn-outline-primary" href="/rrhh/auditoria">Abrir auditoría</a>
      </div>

      @if (!Model.RecentAudit.Any())
      {
        <div class="nl-empty">
          <i class="bi bi-shield-check" aria-hidden="true"></i>
          <p class="mb-0">Sin registros de auditoría todavía.</p>
        </div>
      }
      else
      {
        <ul class="list-group list-group-flush">
          @foreach (var record in Model.RecentAudit)
          {
            <li class="list-group-item d-flex justify-content-between align-items-start gap-3">
              <span style="font-size:13px">
                <span class="fw-medium">@record.Action</span>
                <span class="text-body-secondary"> &middot; @record.ActorId</span>
              </span>
              <span class="text-body-secondary text-nowrap nl-num" style="font-size:12px" title="Hora de Costa Rica">
                @CostaRicaTime.ToLocalDateTime(record.TimestampUtc).ToString("dd/MM/yyyy HH:mm")
              </span>
            </li>
          }
        </ul>
      }
    </div>
  </div>

  <div class="col-lg-5">
    <div class="nl-card h-100">
      <div class="nl-card-header">
        <h2>Consultas frecuentes</h2>
      </div>
      <div class="list-group list-group-flush">
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/rrhh/solicitudes">
          <i class="bi bi-inbox text-body-secondary" aria-hidden="true"></i>
          <span class="flex-grow-1">Solicitudes</span>
          <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
        </a>
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/rrhh/calendario">
          <i class="bi bi-calendar3 text-body-secondary" aria-hidden="true"></i>
          <span class="flex-grow-1">Calendario</span>
          <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
        </a>
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/rrhh/saldos">
          <i class="bi bi-wallet2 text-body-secondary" aria-hidden="true"></i>
          <span class="flex-grow-1">Saldos</span>
          <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
        </a>
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/rrhh/auditoria">
          <i class="bi bi-shield-check text-body-secondary" aria-hidden="true"></i>
          <span class="flex-grow-1">Auditoría</span>
          <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
        </a>
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/rrhh/aprobadores">
          <i class="bi bi-person-badge text-body-secondary" aria-hidden="true"></i>
          <span class="flex-grow-1">Aprobadores</span>
          <span class="badge text-bg-light border nl-num">@Model.ApproversAbleToResolve/@Model.ApproverCount</span>
          <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</div>
