@model NovaLeave.Web.ViewModels.RRHH.RRHHDashboardViewModel
@{
    ViewData["Title"] = "Panel RRHH";
}

<div class="nl-page-header nl-page-header-card">
  <div class="nl-heading-group"><span class="nl-heading-icon"><partial name="_Icon" model="@("briefcase")" /></span><div><h1 class="nl-page-title">Panel Principal de Recursos Humanos</h1><p class="nl-page-description">Supervisión organizacional de vacaciones, saldos de colaboradores y capacidades de aprobadores.</p></div></div>
  <span class="nl-badge nl-readonly">Modo RRHH Lectura Global</span>
</div>

<div class="nl-summary-grid mb-4">
  <section class="nl-card nl-summary-card nl-summary-primary"><div class="nl-summary-label">Total solicitudes org.</div><div class="nl-summary-value">@Model.TotalRequests</div><div class="nl-summary-help">@Model.PendingRequests pendientes de resolución</div></section>
  <section class="nl-card nl-summary-card nl-summary-success"><div class="nl-summary-label">Solicitudes aprobadas</div><div class="nl-summary-value">@Model.ApprovedRequests</div><div class="nl-summary-help">Vacaciones activas u otorgadas</div></section>
  <section class="nl-card nl-summary-card nl-summary-warning"><div class="nl-summary-label">Colaboradores con saldo</div><div class="nl-summary-value">@Model.UsersWithBalance</div><div class="nl-summary-help">Monitoreo de saldos acumulados</div></section>
  <section class="nl-card nl-summary-card nl-summary-purple"><div class="nl-summary-label">Aprobadores registrados</div><div class="nl-summary-value">@Model.RegisteredApprovers</div><div class="nl-summary-help">@Model.ActiveApprovers con capacidad activa</div></section>
</div>

<div class="nl-module-grid nl-module-grid-three">
  <a class="nl-card nl-module-card" href="/rrhh/calendario"><span class="nl-module-icon"><partial name="_Icon" model="@("calendar")" /></span><h2>Calendario Global RRHH</h2><p>Consulta el calendario consolidado de vacaciones de toda la organización.</p><span class="nl-module-link">Ingresar al módulo <partial name="_Icon" model="@("arrow")" /></span></a>
  <a class="nl-card nl-module-card" href="/rrhh/aprobadores"><span class="nl-module-icon nl-module-icon-purple"><partial name="_Icon" model="@("users")" /></span><h2>Gestión de Aprobadores</h2><p>Habilita o deshabilita la capacidad <span class="nl-mono">canResolveRequests</span> para miembros con rol Aprobador.</p><span class="nl-module-link">Ingresar al módulo <partial name="_Icon" model="@("arrow")" /></span></a>
  <a class="nl-card nl-module-card" href="/rrhh/auditoria"><span class="nl-module-icon nl-module-icon-warning"><partial name="_Icon" model="@("shield")" /></span><h2>Bitácora de Auditoría</h2><p>Revisa los eventos de seguridad y negocio inmutables con redacción de datos sensibles.</p><span class="nl-module-link">Ingresar al módulo <partial name="_Icon" model="@("arrow")" /></span></a>
</div>
