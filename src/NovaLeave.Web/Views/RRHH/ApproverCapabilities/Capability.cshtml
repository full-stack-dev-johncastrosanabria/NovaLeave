@model NovaLeave.Web.ViewModels.RRHH.ApproverCapabilities.ApproverCapabilityFormViewModel
@{
    ViewData["Title"] = "Capacidad de aprobador";
}

<section class="nl-page-intro" aria-label="Alcance de la gestión">
  <div>
    <span class="nl-eyebrow">Cambio auditado</span>
    <p>Habilitar permite resolver solicitudes; deshabilitar retira ese acceso de forma inmediata.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/rrhh/aprobadores">Volver</a>
</section>

<div class="nl-card p-3 p-md-4">
<dl class="row nl-definition-list mb-0">
  <dt class="col-sm-3">Aprobador</dt>
  <dd class="col-sm-9">@Model.Approver.DisplayName</dd>
  <dt class="col-sm-3">Puede resolver solicitudes</dt>
  <dd class="col-sm-9">@(Model.Approver.CanResolveRequests ? "Sí, actualmente habilitado" : "No, actualmente deshabilitado")</dd>
</dl>
</div>

<form method="post" action="/rrhh/aprobadores/@Model.Approver.UserId/capacidad" class="nl-card p-3 p-md-4 vstack gap-3">
  @Html.AntiForgeryToken()
  <input type="hidden" name="RowVersion" value="@Model.RowVersion" />

  <div>
    <label class="form-label" for="Enable">Nuevo acceso para resolver solicitudes</label>
    <select class="form-select" id="Enable" name="Enable">
      <option value="true" selected="@Model.Approver.CanResolveRequests">Habilitado</option>
      <option value="false" selected="@(!Model.Approver.CanResolveRequests)">Deshabilitado</option>
    </select>
  </div>

  <div>
    <label class="form-label" for="Reason">Justificación del cambio</label>
    <textarea class="form-control" id="Reason" name="Reason" rows="4" minlength="10" maxlength="500" aria-describedby="reasonHelp"></textarea>
    <div class="form-text" id="reasonHelp">Explica el motivo en 10 a 500 caracteres. Quedará registrado en auditoría.</div>
  </div>

  <div class="form-check">
    <input class="form-check-input" type="checkbox" id="Confirmed" name="Confirmed" value="true" />
    <label class="form-check-label" for="Confirmed">Confirmo que solo cambiará el permiso para resolver solicitudes; el rol de Aprobador no cambia.</label>
  </div>

  <button type="button" class="btn btn-primary align-self-start" data-bs-toggle="modal" data-bs-target="#confirmCapabilityChange">
    Revisar y guardar
  </button>

  <div class="modal fade" id="confirmCapabilityChange" tabindex="-1" aria-labelledby="confirmCapabilityChangeTitle" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5" id="confirmCapabilityChangeTitle">Confirmar cambio de capacidad</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          El acceso para resolver solicitudes cambiará de inmediato. El rol de Aprobador permanecerá sin cambios y la acción quedará auditada.
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Confirmar y guardar</button>
        </div>
      </div>
    </div>
  </div>
</form>
