@model NovaLeave.Web.ViewModels.RRHH.ApproverCapabilities.ApproverCapabilityFormViewModel
@{
    ViewData["Title"] = "Capacidad de aprobador";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">RRHH</p>
    <h1 class="nl-page-title">Capacidad de aprobador</h1>
    <p class="nl-page-description">Cambio controlado de canResolveRequests para un aprobador existente.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/rrhh/aprobadores">Volver</a>
</div>

<section class="nl-card mb-4">
  <div class="nl-card-body">
<dl class="row mb-0">
  <dt class="col-sm-3">Aprobador</dt>
  <dd class="col-sm-9">@Model.Approver.DisplayName</dd>
  <dt class="col-sm-3">Estado actual</dt>
  <dd class="col-sm-9"><span class="nl-badge @(Model.Approver.CanResolveRequests ? "nl-badge-approved" : "nl-badge-neutral")">@(Model.Approver.CanResolveRequests ? "Habilitado para resolver" : "Deshabilitado para resolver")</span></dd>
  <dt class="col-sm-3">Cuenta</dt>
  <dd class="col-sm-9">@(Model.Approver.IsActive ? "Cuenta activa" : "Cuenta inactiva")</dd>
</dl>
  </div>
</section>

<section class="nl-card">
  <div class="nl-card-body">
<form method="post" action="/rrhh/aprobadores/@Model.Approver.UserId/capacidad" class="vstack gap-3" data-submit-once>
  @Html.AntiForgeryToken()
  <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
  <partial name="_ValidationSummary" />

  <div>
    <label class="form-label" for="Enable">Nueva capacidad</label>
    <select class="form-select" id="Enable" name="Enable">
      <option value="true" selected="@(Model.Input.Enable ? "selected" : null)">Habilitado para resolver</option>
      <option value="false" selected="@(!Model.Input.Enable ? "selected" : null)">Deshabilitado para resolver</option>
    </select>
  </div>

  <div>
    <label class="form-label" for="Reason">Justificacion</label>
    <textarea class="form-control" id="Reason" name="Reason" rows="4" minlength="10" maxlength="500" required data-character-source>@Model.Input.Reason</textarea>
    <div class="d-flex justify-content-between"><span class="form-text">Entre 10 y 500 caracteres.</span><span class="form-text" data-character-count>0 / 500</span></div>
  </div>

  <div class="form-check">
    <input class="form-check-input" type="checkbox" id="Confirmed" name="Confirmed" value="true" checked="@(Model.Input.Confirmed ? "checked" : null)" />
    <label class="form-check-label" for="Confirmed">Confirmo que solo se cambiara canResolveRequests.</label>
  </div>

  <button type="button" class="btn btn-primary align-self-start" data-bs-toggle="modal" data-bs-target="#confirmCapabilityChange">
    Guardar capacidad
  </button>

  <div class="modal fade" id="confirmCapabilityChange" tabindex="-1" aria-labelledby="confirmCapabilityChangeTitle" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5" id="confirmCapabilityChangeTitle">Confirmar cambio de capacidad</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          Esta accion cambia solo canResolveRequests y sera efectiva inmediatamente.
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary" data-submit-button>Confirmar y guardar</button>
        </div>
      </div>
    </div>
  </div>
</form>
  </div>
</section>
