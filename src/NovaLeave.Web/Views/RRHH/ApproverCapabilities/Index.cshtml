@model NovaLeave.Web.ViewModels.RRHH.ApproverCapabilities.ApproverCapabilitiesIndexViewModel
@{
    ViewData["Title"] = "Aprobadores RRHH";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">RRHH</p>
    <h1 class="nl-page-title">Gestion de aprobadores</h1>
    <p class="nl-page-description">Control limitado de capacidad para identidades con rol Aprobador.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/rrhh">Volver</a>
</div>

<span class="nl-badge nl-readonly mb-3">Gestiona solo capacidad</span>
@await Html.PartialAsync("_Toast", TempData["Toast"] as string)

<section class="nl-card">
  <div class="nl-card-body">
<div class="table-responsive">
  <table class="table nl-table nl-responsive-table align-middle">
    <caption>Identidades con rol Aprobador</caption>
    <thead>
      <tr>
        <th scope="col">Aprobador</th>
        <th scope="col">Estado</th>
        <th scope="col">Capacidad</th>
        <th scope="col">Accion</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var approver in Model.Approvers)
      {
        <tr>
          <td data-label="Aprobador">@approver.DisplayName</td>
          <td data-label="Estado"><span class="nl-badge @(approver.IsActive ? "nl-badge-approved" : "nl-badge-neutral")">@(approver.IsActive ? "Cuenta activa" : "Cuenta inactiva")</span></td>
          <td data-label="Capacidad"><span class="nl-badge @(approver.CanResolveRequests ? "nl-badge-approved" : "nl-badge-neutral")">@(approver.CanResolveRequests ? "Habilitado para resolver" : "Deshabilitado para resolver")</span></td>
          <td data-label="Accion"><a class="btn btn-sm btn-outline-primary" href="/rrhh/aprobadores/@approver.UserId/capacidad">Cambiar capacidad</a></td>
        </tr>
      }
    </tbody>
  </table>
</div>
  </div>
</section>
