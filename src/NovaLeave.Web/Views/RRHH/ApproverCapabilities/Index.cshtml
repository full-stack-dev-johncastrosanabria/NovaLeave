@model NovaLeave.Web.ViewModels.RRHH.ApproverCapabilities.ApproverCapabilitiesIndexViewModel
@{
    ViewData["Title"] = "Aprobadores RRHH";
}

<section class="nl-page-intro" aria-label="Alcance de la gestión">
  <div>
    <span class="nl-eyebrow">Configuración limitada</span>
    <p>Define quién puede resolver solicitudes. Esta pantalla no asigna ni elimina el rol de Aprobador.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/rrhh">Volver</a>
</section>

@await Html.PartialAsync("_Toast", TempData["Toast"] as string)

<div class="nl-card">
<div class="nl-card-header"><h2>Capacidad para resolver solicitudes</h2><span class="nl-result-count">@Model.Approvers.Count aprobador@(Model.Approvers.Count == 1 ? "" : "es")</span></div>
<div class="table-responsive">
  <table class="table nl-table align-middle">
    <caption class="visually-hidden">Identidades con rol Aprobador</caption>
    <thead>
      <tr>
        <th scope="col">Aprobador</th>
        <th scope="col">Estado</th>
        <th scope="col">Puede resolver solicitudes</th>
        <th scope="col">Acción</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var approver in Model.Approvers)
      {
        <tr>
          <td>@approver.DisplayName</td>
          <td>@(approver.IsActive ? "Activo" : "Inactivo")</td>
          <td><span class="badge @(approver.CanResolveRequests ? "text-bg-success" : "text-bg-secondary")">@(approver.CanResolveRequests ? "Sí, habilitado" : "No, deshabilitado")</span></td>
          <td><a class="btn btn-sm btn-outline-primary" href="/rrhh/aprobadores/@approver.UserId/capacidad">Configurar</a></td>
        </tr>
      }
    </tbody>
  </table>
</div>
</div>
