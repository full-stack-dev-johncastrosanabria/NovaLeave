@model NovaLeave.Web.ViewModels.RRHH.RRHHSolicitudesIndexViewModel
@{
    ViewData["Title"] = "Solicitudes RRHH";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">RRHH</p>
    <h1 class="nl-page-title">Solicitudes</h1>
    <p class="nl-page-description">Consulta organizacional de solicitudes de vacaciones.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <span class="nl-badge nl-readonly">Solo lectura</span>
    <a class="btn btn-outline-secondary" href="/rrhh">Volver</a>
  </div>
</div>

<section class="nl-card">
  <div class="nl-card-body">
<form method="get" class="nl-filter-bar mb-3">
  <div><label class="form-label" for="status">Estado</label><select class="form-select" id="status" name="status"><option value="">Todos</option>@foreach (var status in Enum.GetValues<NovaLeave.Domain.Enums.RequestStatus>()){<option value="@status" selected="@(Context.Request.Query["status"] == status.ToString() ? "selected" : null)">@status</option>}</select></div>
  <button class="btn btn-outline-primary" type="submit">Aplicar filtro</button>
</form>
@if (!Model.Requests.Items.Any())
{
  <div class="nl-empty" role="status"><strong>No se encontraron solicitudes.</strong><span>Ajuste el filtro o consulte otra página.</span></div>
}
else
{
<div class="table-responsive">
  <table class="table nl-table nl-responsive-table align-middle">
    <caption>Solicitudes de vacaciones de la organizacion</caption>
    <thead>
      <tr>
        <th scope="col">Solicitante</th>
        <th scope="col">Inicio</th>
        <th scope="col">Fin</th>
        <th scope="col">Dias</th>
        <th scope="col">Estado</th>
        <th scope="col">Detalle</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var request in Model.Requests.Items)
      {
        <tr>
          <td data-label="Persona"><strong>@request.RequesterName</strong></td>
          <td data-label="Inicio">@request.StartDate.ToString("dd/MM/yyyy")</td>
          <td data-label="Fin">@request.EndDate.ToString("dd/MM/yyyy")</td>
          <td data-label="Días">@request.WorkingDays</td>
          <td data-label="Estado"><partial name="_StatusBadge" model="request.Status.ToString()" /></td>
          <td data-label="Detalle"><a class="btn btn-sm btn-outline-primary" href="/rrhh/solicitudes/@request.Id">Ver detalle</a></td>
        </tr>
      }
    </tbody>
  </table>
</div>
}
  </div>
</section>

@{ var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Requests.TotalCount / (double)Model.Requests.PageSize)); }
<nav class="nl-pagination" aria-label="Paginación de solicitudes"><span>Página @Model.Requests.Page de @totalPages</span><div>@if(Model.Requests.Page > 1){<a class="btn btn-outline-primary" href="?page=@(Model.Requests.Page-1)&status=@Context.Request.Query["status"]">Anterior</a>}@if(Model.Requests.Page < totalPages){<a class="btn btn-outline-primary" href="?page=@(Model.Requests.Page+1)&status=@Context.Request.Query["status"]">Siguiente</a>}</div></nav>
