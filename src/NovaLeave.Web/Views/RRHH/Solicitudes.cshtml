@model NovaLeave.Web.ViewModels.RRHH.RRHHSolicitudesIndexViewModel
@{
    ViewData["Title"] = "Solicitudes RRHH";
}

<section class="nl-page-intro" aria-label="Alcance de la vista">
  <div>
    <span class="nl-eyebrow">Seguimiento de solicitudes</span>
    <p>Consulta todas las solicitudes de vacaciones y abre su detalle para entender período, estado y trazabilidad.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/rrhh">Volver</a>
</section>

<div class="nl-card">
  <div class="nl-card-header">
    <h2>Solicitudes de la organización</h2>
    <span class="nl-result-count">@Model.Requests.TotalCount registro@(Model.Requests.TotalCount == 1 ? "" : "s")</span>
  </div>
  @if (!Model.Requests.Items.Any())
  {
    <div class="nl-empty"><i class="bi bi-inbox" aria-hidden="true"></i><p class="mb-0">No hay solicitudes para mostrar.</p></div>
  }
  else
  {
  <div class="table-responsive">
    <table class="table nl-table align-middle">
    <caption class="visually-hidden">Solicitudes de vacaciones de la organizacion</caption>
    <thead>
      <tr>
        <th scope="col">Solicitante</th>
        <th scope="col">Inicio</th>
        <th scope="col">Fin</th>
        <th scope="col">Días</th>
        <th scope="col">Estado</th>
        <th scope="col">Detalle</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var request in Model.Requests.Items)
      {
        <tr>
          <td>@request.RequesterName</td>
          <td>@request.StartDate.ToString("yyyy-MM-dd")</td>
          <td>@request.EndDate.ToString("yyyy-MM-dd")</td>
          <td>@request.WorkingDays</td>
          <td>@await Html.PartialAsync("_StatusBadge", request.Status.ToString())</td>
          <td><a class="btn btn-sm btn-outline-primary" href="/rrhh/solicitudes/@request.Id">Ver detalle</a></td>
        </tr>
      }
    </tbody>
    </table>
  </div>
  }
</div>

<p class="text-body-secondary nl-result-count">Página @Model.Requests.Page de @Model.Requests.TotalPages</p>
