@model NovaLeave.Web.ViewModels.RRHH.RRHHSolicitudDetalleViewModel
@{
    ViewData["Title"] = "Detalle RRHH";
}

<section class="nl-page-intro" aria-label="Alcance de la vista">
  <div>
    <span class="nl-eyebrow">Detalle y trazabilidad</span>
    <p>Información completa de la solicitud y registro de los eventos que explican su estado actual.</p>
  </div>
  <a class="btn btn-outline-secondary" href="/rrhh/solicitudes">Volver</a>
</section>

<div class="nl-card p-3 p-md-4">
<dl class="row nl-definition-list mb-0">
  <dt class="col-sm-3">Solicitante</dt>
  <dd class="col-sm-9">@Model.Request.RequesterName</dd>
  <dt class="col-sm-3">Inicio</dt>
  <dd class="col-sm-9">@Model.Request.StartDate.ToString("yyyy-MM-dd")</dd>
  <dt class="col-sm-3">Fin</dt>
  <dd class="col-sm-9">@Model.Request.EndDate.ToString("yyyy-MM-dd")</dd>
  <dt class="col-sm-3">Días hábiles</dt>
  <dd class="col-sm-9">@Model.Request.WorkingDays</dd>
  <dt class="col-sm-3">Estado</dt>
  <dd class="col-sm-9">@await Html.PartialAsync("_StatusBadge", Model.Request.Status.ToString())</dd>
  <dt class="col-sm-3">Motivo de la solicitud</dt>
  <dd class="col-sm-9">@Model.Request.Reason</dd>
  @if (!string.IsNullOrWhiteSpace(Model.Request.RejectionReason))
  {
    <dt class="col-sm-3">Razón de rechazo</dt>
    <dd class="col-sm-9">@Model.Request.RejectionReason</dd>
  }
</dl>
</div>

<div class="nl-card">
<div class="nl-card-header"><h2>Trazabilidad de la solicitud</h2><span class="nl-result-count">@Model.Request.AuditTrail.Count evento@(Model.Request.AuditTrail.Count == 1 ? "" : "s")</span></div>
<div class="table-responsive">
  <table class="table nl-table align-middle">
    <caption class="visually-hidden">Auditoría de la solicitud</caption>
    <thead>
      <tr>
        <th scope="col">Fecha y hora (Costa Rica)</th>
        <th scope="col">Actor</th>
        <th scope="col">Rol</th>
        <th scope="col">Acción</th>
        <th scope="col">Resultado</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var item in Model.Request.AuditTrail)
      {
        <tr>
          <td>@CostaRicaTime.ToLocalDateTime(item.TimestampUtc).ToString("dd/MM/yyyy HH:mm")</td>
          <td>@item.ActorId</td>
          <td>@item.ActorRole</td>
          <td>@item.Action</td>
          <td>@item.Result</td>
        </tr>
      }
    </tbody>
  </table>
</div>
</div>
