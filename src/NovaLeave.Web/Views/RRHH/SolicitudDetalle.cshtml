@model NovaLeave.Web.ViewModels.RRHH.RRHHSolicitudDetalleViewModel
@{
    ViewData["Title"] = "Detalle RRHH";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">RRHH</p>
    <h1 class="nl-page-title">Detalle de solicitud</h1>
    <p class="nl-page-description">Vista de consulta de la solicitud y su auditoria.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <span class="nl-badge nl-readonly">Solo lectura</span>
    <a class="btn btn-outline-secondary" href="/rrhh/solicitudes">Volver</a>
  </div>
</div>

<section class="nl-card mb-4">
  <div class="nl-card-body">
<dl class="row mb-0">
  <dt class="col-sm-3">Solicitante</dt>
  <dd class="col-sm-9">@Model.Request.RequesterName</dd>
  <dt class="col-sm-3">Inicio</dt>
  <dd class="col-sm-9">@Model.Request.StartDate.ToString("yyyy-MM-dd")</dd>
  <dt class="col-sm-3">Fin</dt>
  <dd class="col-sm-9">@Model.Request.EndDate.ToString("yyyy-MM-dd")</dd>
  <dt class="col-sm-3">Dias habiles</dt>
  <dd class="col-sm-9">@Model.Request.WorkingDays</dd>
  <dt class="col-sm-3">Estado</dt>
  <dd class="col-sm-9"><partial name="_StatusBadge" model="Model.Request.Status.ToString()" /></dd>
  <dt class="col-sm-3">Razon</dt>
  <dd class="col-sm-9">@Model.Request.Reason</dd>
  @if (!string.IsNullOrWhiteSpace(Model.Request.RejectionReason))
  {
    <dt class="col-sm-3">Razon de rechazo</dt>
    <dd class="col-sm-9">@Model.Request.RejectionReason</dd>
  }
</dl>
  </div>
</section>

<section class="nl-card">
  <div class="nl-card-body">
<h2 class="h5 mb-3">Auditoria</h2>
<div class="table-responsive">
  <table class="table nl-table nl-table-card align-middle">
    <caption>Auditoria de la solicitud</caption>
    <thead>
      <tr>
        <th scope="col">Fecha</th>
        <th scope="col">Actor</th>
        <th scope="col">Rol</th>
        <th scope="col">Accion</th>
        <th scope="col">Resultado</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var item in Model.Request.AuditTrail)
      {
        <tr>
          <td>@item.TimestampUtc</td>
          <td>@item.ActorId</td>
          <td>@item.ActorRole</td>
          <td>@item.Action</td>
          <td>@item.Result</td>
        </tr>
      }
    </tbody>
  </table>
</div>
  </div>
</section>
