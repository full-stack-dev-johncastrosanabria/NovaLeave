@model NovaLeave.Web.ViewModels.RRHH.RRHHMovimientosViewModel
@{
    ViewData["Title"] = "Movimientos RRHH";
}

<div class="nl-page-header">
  <div>
    <p class="nl-page-kicker">RRHH</p>
    <h1 class="nl-page-title">Movimientos</h1>
    <p class="nl-page-description">Historial de movimientos para el usuario seleccionado.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <span class="nl-badge nl-readonly">Solo lectura</span>
    <a class="btn btn-outline-secondary" href="/rrhh/saldos">Volver</a>
  </div>
</div>

<section class="nl-card mb-4">
  <div class="nl-card-body">
    <h2 class="h5 mb-3">@Model.Balance.UserName</h2>
    <div class="nl-summary-grid">
      <div><div class="nl-summary-label">Acumulado total</div><div class="nl-summary-value">@Model.Balance.AccruedDays</div></div>
      <div><div class="nl-summary-label">Pendientes</div><div class="nl-summary-value">@Model.Balance.ReservedDays</div></div>
      <div><div class="nl-summary-label">Días gozados</div><div class="nl-summary-value">@Model.Balance.DeductedDays</div></div>
      <div><div class="nl-summary-label">Disponible</div><div class="nl-summary-value">@Model.Balance.AvailableDays</div></div>
    </div>
  </div>
</section>

<section class="nl-card">
  <div class="nl-card-body">
<div class="table-responsive">
  <table class="table nl-table nl-table-card align-middle">
    <caption>Movimientos de saldo</caption>
    <thead>
      <tr>
        <th scope="col">Fecha</th>
        <th scope="col">Tipo</th>
        <th scope="col">Dias</th>
        <th scope="col">Solicitud</th>
        <th scope="col">Periodo</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var movement in Model.Balance.Movements)
      {
        <tr>
          <td>@movement.EffectiveAtUtc</td>
          <td>@movement.Type</td>
          <td>@movement.Amount</td>
          <td>@movement.RequestId</td>
          <td>@movement.AccrualPeriod</td>
        </tr>
      }
    </tbody>
  </table>
</div>
  </div>
</section>
