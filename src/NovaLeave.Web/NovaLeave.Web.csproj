<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!--
      Design-time only, required for `dotnet ef` to use this project as the
      startup project (it builds the host to resolve NovaLeaveDbContext and its
      configuration). Infrastructure also references it, but with
      PrivateAssets=all it does not flow transitively to consumers.

      PrivateAssets=all keeps this out of the published output and out of any
      project referencing NovaLeave.Web, so it adds no runtime dependency and
      does not weaken the Clean Architecture boundary: Presentation still must
      not touch DbContext or repositories directly (constitution §2.I).
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaLeave.Application\NovaLeave.Application.csproj" />
    <ProjectReference Include="..\NovaLeave.Infrastructure\NovaLeave.Infrastructure.csproj" />
  </ItemGroup>

</Project>
