@page
@model NovaLeave.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
  <div class="col-12 col-sm-10 col-md-7 col-lg-5">

    <div class="text-center mb-4">
      <i class="bi bi-calendar2-check text-primary" style="font-size:2.25rem" aria-hidden="true"></i>
      <h1 class="h4 mt-2 mb-1">NovaLeave</h1>
      <p class="text-body-secondary mb-0">Gestión de solicitudes de vacaciones</p>
    </div>

    <div class="nl-card p-4">
      <h2 class="h6 mb-3">Iniciar sesión</h2>

      <form method="post" novalidate>
        @if (!ViewData.ModelState.IsValid)
        {
          <div class="nl-alert nl-alert-error" role="alert" aria-live="polite" tabindex="-1" id="loginErrorSummary">
            <span class="nl-alert-icon" aria-hidden="true">
              <i class="bi bi-exclamation-circle"></i>
            </span>
            <div class="nl-alert-content">
              <p class="nl-alert-title">No pudimos iniciar sesión</p>
              <div asp-validation-summary="ModelOnly" class="nl-alert-message"></div>
            </div>
          </div>
        }

        <div class="mb-3">
          <label asp-for="Input.Email" class="form-label">Correo</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope" aria-hidden="true"></i></span>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-describedby="Input_Email-error" autofocus />
          </div>
          <span asp-validation-for="Input.Email" class="text-danger small" id="Input_Email-error"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Input.Password" class="form-label">Contraseña</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock" aria-hidden="true"></i></span>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-describedby="Input_Password-error" />
          </div>
          <span asp-validation-for="Input.Password" class="text-danger small" id="Input_Password-error"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">
          <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
          <span class="ms-1">Iniciar sesión</span>
        </button>
      </form>
    </div>

    @if (Model.ShowDemoIdentities)
    {
      @* Development and Staging only: never rendered when demo seeding is disabled. *@
      <div class="nl-card p-3 mt-3">
        <p class="small fw-semibold mb-2">Usuarios disponibles</p>
        <ul class="list-unstyled small mb-0 vstack gap-1" aria-label="Usuarios disponibles para demostración">
          <li><code>user@@demo</code></li>
          <li><code>approver@@demo</code></li>
          <li><code>hr@@demo</code></li>
          <li><code>multi@@demo</code></li>
        </ul>
      </div>
    }
  </div>
</div>
